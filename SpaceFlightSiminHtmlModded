};
const _origStep=stepSimSeconds;
stepSimSeconds=function(f,simSeconds,tStart,maxSubstepDtOverride){
  _origStep(f,simSeconds,tStart,maxSubstepDtOverride);
  applyAeroHeating(f, Math.min(simSeconds,1));
  tryDrill(f, Math.min(simSeconds,0.05));
};

// ---- Menu wiring (null-safe so one missing node cannot kill the whole game) ----
function on(id, ev, fn){ const n=el(id); if(n) n[ev]=fn; }
on('menuNewWorld','onclick',goNewWorldWizard);
on('menuResume','onclick',openResumeList);
on('nwCreate','onclick',createWorldFromWizard);
on('nwBack','onclick',hideAllMenuPanels);
on('resumeBack','onclick',hideAllMenuPanels);
on('menuMods','onclick',()=>{
  hideAllMenuPanels();
  if(el('mainMenuCard')) el('mainMenuCard').style.display='none';
  if(el('modPanel')) el('modPanel').style.display='flex';
  if(el('modRealisticTex')) el('modRealisticTex').checked=!!modSettings.realisticTextures;
  if(el('modVanillaTex')) el('modVanillaTex').checked=!!modSettings.vanillaTex;
  if(el('modFairings')) el('modFairings').checked=!!modSettings.fairings;
  if(el('modHeat')) el('modHeat').checked=!!modSettings.heat;
  if(el('modAnimals')) el('modAnimals').checked=!!modSettings.animals;
});
on('modBack','onclick',hideAllMenuPanels);
on('modRealisticTex','onchange',e=>{
  modSettings.realisticTextures=e.target.checked;
  if(e.target.checked){ modSettings.vanillaTex=false; if(el('modVanillaTex')) el('modVanillaTex').checked=false; }
  saveModSettings(); rebuildAllSprites();
  showToast(modSettings.realisticTextures?'Realistic textures ON':'Mod textures OFF');
});
on('modVanillaTex','onchange',e=>{
  modSettings.vanillaTex=e.target.checked;
  if(e.target.checked){ modSettings.realisticTextures=false; if(el('modRealisticTex')) el('modRealisticTex').checked=false; }
  saveModSettings(); rebuildAllSprites();
  showToast(modSettings.vanillaTex?'Vanilla Textures (remaster) ON':'Vanilla Textures OFF');
});
on('modFairings','onchange',e=>{ modSettings.fairings=e.target.checked; saveModSettings(); rebuildAllSprites(); });
on('modHeat','onchange',e=>{ modSettings.heat=e.target.checked; saveModSettings(); });
on('modAnimals','onchange',e=>{ modSettings.animals=e.target.checked; saveModSettings(); });

// Import JSON mod only — { "name": "...", "parts": [ ... ] }
if(el('modImportFile')) el('modImportFile').onchange=async e=>{
  const file=e.target.files&&e.target.files[0]; if(!file) return;
  const text=await file.text();
  try{
    if(!file.name.toLowerCase().endsWith('.json')&&!file.type.includes('json')){
      showToast('Mods must be .json files'); return;
    }
    const mod=JSON.parse(text);
    if(!mod||!Array.isArray(mod.parts)){
      showToast('JSON mod needs: { "name": "...", "parts": [ ... ] }'); return;
    }
    let added=0;
    mod.parts.forEach(p=>{
      if(!p||!p.id) return;
      // Defaults so a minimal tank still works
      PARTS[p.id]={
        dryMass:0, fuel:0, thrust:0, fuelRate:0, color:'#aaaaaa', type:'tank', cat:'Fuel',
        w:2, h:2, name:p.id,
        ...p
      };
      added++;
    });
    while(PART_LIST.length) PART_LIST.pop();
    Object.values(PARTS).forEach(p=>PART_LIST.push(p));
    importedMods.push({name:mod.name||file.name, on:true, count:added});
    buildPalette();
    showToast('Imported JSON mod: '+(mod.name||file.name)+' ('+added+' parts)');
    renderImportedMods();
  }catch(err){ showToast('JSON mod failed: '+err.message); }
  e.target.value='';
};
function renderImportedMods(){
  const box=el('importedModsList'); if(!box) return;
  box.innerHTML=importedMods.map((m,i)=>
    `<label class="mod-row"><input type="checkbox" ${m.on?'checked':''} data-i="${i}"> ${m.name}${m.count?' ('+m.count+')':''}</label>`
  ).join('')||'<div style="color:#888;">No mods imported yet</div>';
}

