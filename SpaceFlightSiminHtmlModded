on('toMenuBtn','onclick',()=>{ try{ persistActiveWorld(); }catch(err){} showScreen('menuScreen'); });

// EVA + QoL keys
window.addEventListener('keydown',e=>{
  if(document.activeElement&&(document.activeElement.tagName==='INPUT'||document.activeElement.tagName==='TEXTAREA')) return;
  const k=e.key.toLowerCase();
  // Escape — close panels / back to menu
  if(e.key==='Escape'){
    if(el('planetCtxMenu')) el('planetCtxMenu').style.display='none';
    if(el('shipCtxMenu')) el('shipCtxMenu').style.display='none';
    if(mode==='flight'||mode==='build'){
      // soft return: show toast, don't force
      showToast('Esc · Menu button top-right to leave');
    }
    return;
  }
  if(mode!=='flight') return;
  const sh=activeShip();
  if(k==='m'){
    const outside=astronauts.some(a=>a.shipId===(sh&&sh.id)&&a.outside);
    if(outside) boardAstronaut(sh); else spawnAstronaut(sh);
  }
  if(k==='g') plantFlag();
  if(k==='k'&&astronauts.some(a=>a.outside)){
    const a=astronauts.find(x=>x.outside);
    a.grabbed=!a.grabbed;
    showToast(a.grabbed?'Grabbed ship (K)':'Released');
  }
  // [ ] throttle steps (QoL)
  if((k==='['||k===']')&&sh){
    const step=k===']'?0.05:-0.05;
    sh.throttle=Math.max(0,Math.min(1,(sh.throttle||0)+step));
    if(el('throttleSlider')) el('throttleSlider').value=Math.round(sh.throttle*100);
    if(hud.throttle) hud.throttle.textContent=Math.round(sh.throttle*100)+'%';
  }
  // X abort / engine kill
  if(k==='x'&&sh){ sh.engineOn=false; if(typeof updateEngineBtn==='function') updateEngineBtn(); showToast('Engine cut (X)'); }
  // Capslock-less: Home key resets free-cam to ship
  if(e.key==='Home'&&typeof setCamFree==='function'){ setCamFree(false); showToast('Camera locked to ship'); }
});

// Persist worlds periodically
const _saveShips=saveShips;
saveShips=function(){ _saveShips(); persistActiveWorld(); };

// Campaign contract tick — pay small amount for reaching space
ships._campaignHook=true;
setInterval(()=>{
  if(!activeWorld||activeWorld.mode!=='campaign') return;
  const sh=activeShip();
  if(sh&&sh.status==='flying'&&!sh._spaceBonus){
    const ppos=sh._domBody?planetPositionAt(sh._domBody,simTime):null;
    if(ppos){
      const alt=Math.hypot(sh.pos.x-ppos.x,sh.pos.y-ppos.y)-(sh._domBody.radius||0);
      if(alt>sh._domBody.radius*0.05){
        sh._spaceBonus=true; activeWorld.money+=10000;
        showToast('Contract complete: Reach space · +$10,000');
      }
    }
  }
},2000);

// EVA update in main loop (real frame dt, not fixed 16ms)
let _evaLast=performance.now();
const _loop=loop;
loop=function(now){
  _loop(now);
  if(mode==='flight'){
    const dt=Math.min(0.05,(now-_evaLast)/1000);
    _evaLast=now;
    updateAstronauts(dt);
  } else {
    _evaLast=now;
  }
};

loadWorldRegistry();
showScreen('menuScreen');
updateMenuSaveInfo();
requestAnimationFrame(loop);

})();
