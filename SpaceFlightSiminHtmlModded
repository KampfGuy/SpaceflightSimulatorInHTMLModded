    // visor shine
    fctx.fillStyle='rgba(255,255,255,0.35)';
    fctx.beginPath(); fctx.ellipse(-sc*0.08,-sc*0.62,sc*0.12,sc*0.08, -0.4, 0, Math.PI*2); fctx.fill();
    fctx.restore();
  });
}

