  if(sh){
    const distS=Math.hypot(sh.pos.x-SUN_POS.x,sh.pos.y-SUN_POS.y)-SUN_RADIUS;
    hud.altS.textContent=fmtDist(distS);
    if(sh._domBody){
      const ppos=planetPositionAt(sh._domBody,simTime);
      const pv=planetVelocityAt(sh._domBody,simTime);
      const speed=Math.hypot(sh.vel.x-pv.x,sh.vel.y-pv.y);
      hud.speed.textContent=fmtSpeed(speed);
      const alt=Math.hypot(sh.pos.x-ppos.x,sh.pos.y-ppos.y)-sh._domBody.radius;
