function saveShips(){
  try{
    const data=ships
      .filter(s=>s.status==='flying')
      .map(s=>({
        id:s.id, name:s.name, parts:s.parts,
        pos:s.pos, vel:s.vel, angle:s.angle,
        dryMass:s.dryMass, fuel:s.fuel, fuelCap:s.fuelCap,
        thrust:s.thrust, fuelRate:s.fuelRate,
        tankFuel:s.tankFuel, engineEnabled:s.engineEnabled,
        throttle:s.throttle, chuteDeployed:s.chuteDeployed,
        status:s.status,
      }));
    localStorage.setItem(SAVE_KEY,JSON.stringify({simTime,shipCounter,ships:data}));
  }catch(err){}
}
function loadShips(){
  try{
    const raw=localStorage.getItem(SAVE_KEY);
    if(!raw) return false;
    const data=JSON.parse(raw);
    if(!data||!Array.isArray(data.ships)||!data.ships.length) return false;
    simTime=typeof data.simTime==='number'?data.simTime:0;
    shipCounter=typeof data.shipCounter==='number'?data.shipCounter:data.ships.length;
    ships=data.ships.map(s=>{
      const parts=Array.isArray(s.parts)&&s.parts.length?s.parts:[{id:'pod',col:0,row:0,uid:partUidCounter++}];
      parts.forEach(pp=>{ if(pp.uid===undefined) pp.uid=partUidCounter++; });
      partUidCounter=Math.max(partUidCounter,...parts.map(pp=>pp.uid+1));
      const sprite=buildSprite(parts);
      const tankFuel=s.tankFuel||{};
      const engineEnabled=s.engineEnabled||{};
      parts.forEach(pp=>{
        if(PARTS[pp.id].type==='tank'&&!(pp.uid in tankFuel)) tankFuel[pp.uid]=PARTS[pp.id].fuel;
        if(PARTS[pp.id].type==='engine'&&!(pp.uid in engineEnabled)) engineEnabled[pp.uid]=true;
      });
      return {
        id:s.id, name:s.name, parts, sprite,
        pos:s.pos, vel:s.vel, angle:s.angle||0,
        dryMass:s.dryMass, fuel:Object.values(tankFuel).reduce((a,b)=>a+b,0), fuelCap:s.fuelCap,
        thrust:s.thrust, fuelRate:s.fuelRate,
        tankFuel, engineEnabled, engineConnections:computeEngineConnections(parts),
        engineOn:false, throttle:typeof s.throttle==='number'?s.throttle:1,
        chuteDeployed:!!s.chuteDeployed,
        status:'flying', statusMsg:'',
        trail:makeTrail(), lastTrailPos:null, _inAtmo:false, _domBody:null,
      };
    });
    return true;
  }catch(err){ return false; }
}

