<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Spaceflight Sim — Original by Rough_Capital1339/CatPrinceHQ2 · Mod by KampfGuy</title>
<style>
  :root{
    --primary:#1A1A1A;
    --secondary:#EBEBEB;
    --accent:#FF4500;
    --bg:#FAFAFA;
    --panel-bg:rgba(250,250,250,0.95);
    --void:#141414;
    --danger:#B3261E;
    --ok:#2E7D32;
    --font-head:Georgia,'Times New Roman',serif;
    --font-body:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    --sp-1:2px; --sp-2:4px; --sp-3:8px; --sp-4:12px; --sp-5:18px; --sp-6:28px;
  }
  body.dark-mode{
    --primary:#EDEDED;
    --secondary:#333333;
    --bg:#121212;
    --panel-bg:rgba(20,20,20,0.94);
    --danger:#FF6E62;
    --ok:#4CAF50;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;height:100%;background:var(--bg);color:var(--primary);font-family:var(--font-body);overflow:hidden;}
  #app{display:flex;flex-direction:column;height:100%;}

  header{
    padding:var(--sp-3) var(--sp-5);border-bottom:1px solid var(--primary);
    display:flex;align-items:center;gap:var(--sp-4);background:var(--bg);flex-wrap:wrap;
    transition:padding .15s ease;
  }
  header.collapsed{padding-top:var(--sp-2);padding-bottom:var(--sp-2);}
  header.collapsed>*:not(#headerCollapseBtn){display:none;}
  header h1{margin:0;font-family:var(--font-body);font-weight:800;font-size:21px;color:var(--primary);}
  .header-actions{margin-left:auto;display:flex;align-items:center;gap:var(--sp-3);}
  .vol-ctl{display:flex;align-items:center;gap:6px;}
  .vol-icon{font-size:14px;width:18px;text-align:center;user-select:none;}
  .vol-ctl input[type=range]{
    -webkit-appearance:none;appearance:none;width:90px;height:4px;border-radius:2px;
    background:#9A9A9A;outline:none;cursor:pointer;
  }
  body.dark-mode .vol-ctl input[type=range]{
    background:#C7C7C7;
  }
  .vol-ctl input[type=range]::-webkit-slider-thumb{
    -webkit-appearance:none;appearance:none;width:13px;height:13px;border-radius:50%;
    background:var(--accent);cursor:pointer;border:2px solid var(--bg);
  }
  .vol-ctl input[type=range]::-moz-range-thumb{
    width:13px;height:13px;border-radius:50%;background:var(--accent);cursor:pointer;border:2px solid var(--bg);
  }
  #headerCollapseBtn{
    background:var(--bg);border:1px solid var(--primary);color:var(--primary);font-family:var(--font-body);
    font-weight:700;font-size:11px;padding:6px 10px;border-radius:0;cursor:pointer;
  }
  #headerCollapseBtn:hover{border-color:var(--accent);color:var(--accent);}
  .mode-btn{
    background:var(--primary);border:1px solid var(--primary);color:var(--bg);
    font-family:var(--font-body);font-weight:600;font-size:12px;padding:8px 16px;border-radius:0;cursor:pointer;letter-spacing:.02em;
  }
  .mode-btn:hover{background:var(--accent);border-color:var(--accent);}
  .mode-btn.secondary{background:var(--bg);color:var(--primary);}
  .mode-btn.secondary:hover{background:var(--primary);color:var(--bg);}

  #screens{flex:1;display:flex;min-height:0;position:relative;}
  .screen{flex:1;display:none;min-height:0;position:relative;}
  .screen.active{display:flex;}

  /* MAIN MENU */
  #menuScreen{
    align-items:center;justify-content:center;
    background:radial-gradient(ellipse at 50% 30%, #1a2030 0%, #0a0a0c 70%);
  }
  .menu-wrap{display:flex;gap:28px;flex-wrap:wrap;justify-content:center;padding:24px;}
  .menu-card{
    background:rgba(250,250,250,0.95);border:1px solid #1A1A1A;
    padding:28px 32px;min-width:280px;max-width:360px;
    display:flex;flex-direction:column;gap:12px;
  }
  body.dark-mode .menu-card{background:rgba(22,22,26,0.96);border-color:#EDEDED;}
  .menu-logo{
    font-family:var(--font-body);font-weight:800;font-size:26px;letter-spacing:.04em;
    color:var(--primary);text-align:center;
  }
  .menu-sub{font-size:12px;color:#777;text-align:center;margin-bottom:8px;}
  .menu-btn{
    background:var(--bg);border:1px solid var(--primary);color:var(--primary);
    font-family:var(--font-body);font-weight:700;font-size:14px;
    padding:12px 18px;cursor:pointer;border-radius:0;text-align:center;
  }
  .menu-btn:hover{border-color:var(--accent);color:var(--accent);}
  .menu-btn.primary{background:var(--primary);color:var(--bg);}
  .menu-btn.primary:hover{background:var(--accent);border-color:var(--accent);color:#fff;}
  .menu-btn:disabled{opacity:.35;cursor:not-allowed;}
  .menu-foot{font-size:11px;color:#888;text-align:center;margin-top:6px;}
  .mod-row{
    display:flex;align-items:center;gap:10px;font-size:13px;padding:8px 0;
    border-bottom:1px solid var(--secondary);cursor:pointer;user-select:none;
  }
  .mod-row input{accent-color:var(--accent);width:16px;height:16px;cursor:pointer;}

  .float-panel{
    position:absolute;background:var(--panel-bg);border:1px solid var(--primary);
    border-radius:0;box-shadow:none;padding:var(--sp-4);z-index:2;
  }
  .float-panel h3{
    margin:0 0 var(--sp-3);font-family:var(--font-body);font-weight:700;
    font-size:13px;color:var(--primary);border-bottom:1px solid var(--secondary);padding-bottom:var(--sp-2);
  }

  /* BUILD SCREEN */
  #buildScreen{padding:0;}
  #gridCanvas{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:crosshair;background:var(--void);z-index:0;}

  .float-palette{top:var(--sp-5);left:var(--sp-5);width:240px;max-height:calc(100% - 2*var(--sp-5));overflow-y:auto;display:flex;flex-direction:column;gap:var(--sp-2);}
  .part-card{background:var(--bg);border:1px solid var(--primary);padding:var(--sp-3);cursor:pointer;border-radius:0;}
  .part-card:hover{border-color:var(--accent);}
  .part-card.selected{border-color:var(--accent);background:#fff0ea;}
  .part-card .pname{font-size:12.5px;font-weight:700;display:flex;align-items:center;gap:var(--sp-2);}
  .part-card .swatch{width:11px;height:11px;border:1px solid var(--primary);flex-shrink:0;}
  .part-card .pstats{font-size:10.5px;color:#555;margin-top:var(--sp-2);line-height:1.55;}

  .float-stats{top:var(--sp-5);right:var(--sp-5);width:206px;}
  .float-savedrockets{top:calc(var(--sp-5) + 216px);right:var(--sp-5);width:206px;max-height:220px;overflow-y:auto;}
  .saved-rocket-row{display:flex;justify-content:space-between;align-items:center;gap:var(--sp-2);font-size:11.5px;padding:5px 4px;border-bottom:1px solid var(--secondary);}
  .saved-rocket-row:last-child{border-bottom:none;}
  .saved-rocket-row .rocket-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .stat-line{display:flex;justify-content:space-between;font-size:12px;padding:2px 0;}
  .stat-line b{color:var(--accent);font-weight:700;}
  .warn-text{font-size:11px;color:var(--danger);margin-top:var(--sp-3);font-weight:600;}

  .float-zoom{bottom:var(--sp-5);right:var(--sp-5);display:flex;gap:var(--sp-2);padding:var(--sp-2);}
  .icon-btn{
    width:30px;height:30px;background:var(--bg);border:1px solid var(--primary);color:var(--primary);
    font-family:var(--font-body);font-weight:700;font-size:15px;cursor:pointer;border-radius:0;
    display:flex;align-items:center;justify-content:center;padding:0;
  }
  .icon-btn:hover{background:var(--primary);color:var(--bg);}

  #buildActionBar{bottom:var(--sp-5);left:50%;transform:translateX(-50%);display:flex;gap:var(--sp-3);padding:var(--sp-3);}
  .btn{
    background:var(--bg);border:1px solid var(--primary);color:var(--primary);font-family:var(--font-body);
    font-weight:600;font-size:12.5px;padding:10px 18px;border-radius:0;cursor:pointer;letter-spacing:.02em;
  }
  .btn:hover{border-color:var(--accent);color:var(--accent);}
  .btn.primary{background:var(--primary);border-color:var(--primary);color:var(--bg);}
  .btn.primary:hover{background:var(--accent);border-color:var(--accent);color:#fff;}
  .btn.primary:disabled{opacity:.35;cursor:not-allowed;background:var(--secondary);color:#888;border-color:var(--secondary);}
  .btn.danger:hover{border-color:var(--danger);color:var(--danger);}
  .btn.small{padding:6px 10px;font-size:11px;}
  .btn:disabled{opacity:.35;cursor:not-allowed;}

  .float-hint{bottom:var(--sp-5);left:var(--sp-5);font-size:10.5px;color:#444;padding:6px 10px;}

  /* FLIGHT SCREEN */
  #flightScreen{padding:0;}
  #flightCanvas{position:absolute;inset:0;width:100%;height:100%;display:block;background:var(--void);z-index:0;cursor:crosshair;}

  .float-hud{top:var(--sp-5);left:var(--sp-5);width:206px;}
  .hline{display:flex;justify-content:space-between;gap:var(--sp-4);font-size:11.5px;padding:2px 0;}
  .hline b{color:var(--accent);font-weight:700;text-align:right;}
  #typeEditPanel{margin-top:var(--sp-3);border-top:1px solid var(--secondary);padding-top:var(--sp-3);}
  .te-input{
    width:76px;background:var(--bg);border:1px solid var(--primary);color:var(--primary);
    font-family:var(--font-body);font-size:11px;padding:2px 4px;border-radius:0;text-align:right;
  }
  #status-msg{margin-top:var(--sp-3);font-size:12px;font-weight:700;min-height:16px;}
  .status-land{color:var(--ok);}
  .status-crash{color:var(--danger);}

  /* top set in JS by positionShipList() — depends on HUD height, which shifts with the TypeEdit panel */
  .float-ships{left:var(--sp-5);width:206px;max-height:160px;overflow-y:auto;display:none;}
  .ship-row{display:flex;justify-content:space-between;align-items:center;gap:var(--sp-2);font-size:11.5px;padding:5px 4px;cursor:pointer;border-bottom:1px solid var(--secondary);}
  .ship-row:last-child{border-bottom:none;}
  .ship-row.active{background:#fff0ea;font-weight:700;}
  .ship-row .ship-status{font-size:9.5px;text-transform:uppercase;letter-spacing:.05em;color:#777;}
  .ship-row .status-crashed{color:var(--danger);}
  .ship-row .status-landed{color:var(--ok);}
  .ship-row .ship-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .ship-row .ship-del{
    flex-shrink:0;background:none;border:1px solid var(--secondary);color:var(--danger);
    font-family:var(--font-body);font-size:10px;line-height:1;padding:3px 6px;cursor:pointer;border-radius:0;
  }
  .ship-row .ship-del:hover{border-color:var(--danger);background:var(--danger);color:#fff;}

  .float-staging{top:var(--sp-5);left:calc(var(--sp-5) + 224px);width:180px;max-height:260px;overflow-y:auto;display:none;}
  .stage-row{display:flex;justify-content:space-between;align-items:center;gap:var(--sp-2);padding:4px 0;}
  .stage-row span{font-size:11px;}
  .engine-row .btn{min-width:38px;text-align:center;}

  .float-zoompresets{top:var(--sp-5);right:var(--sp-5);display:flex;flex-direction:column;gap:var(--sp-2);padding:var(--sp-2);}
  .zbtn{
    background:var(--bg);border:1px solid var(--primary);color:var(--primary);font-family:var(--font-body);
    font-weight:600;font-size:11.5px;padding:8px 12px;cursor:pointer;border-radius:0;text-align:left;
  }
  .zbtn:hover{border-color:var(--accent);color:var(--accent);}

  /* Fuel tanks panel */
  .float-fuel{
    top:calc(var(--sp-5) + 168px);right:var(--sp-5);width:192px;max-height:150px;overflow-y:auto;display:none;
  }
  .fuel-row{display:flex;justify-content:space-between;align-items:center;gap:var(--sp-2);font-size:10.5px;padding:3px 0;border-bottom:1px solid var(--secondary);}
  .fuel-row:last-child{border-bottom:none;}
  .fuel-row .fuel-name{flex-shrink:0;}
  .fuel-row .fuel-bar-wrap{flex:1;height:6px;background:var(--secondary);position:relative;}
  .fuel-row .fuel-bar{position:absolute;left:0;top:0;bottom:0;background:var(--accent);}
  .fuel-row .fuel-pct{flex-shrink:0;width:30px;text-align:right;font-weight:700;color:var(--accent);}

  /* Cheats panel — pushed below the fuel tanks panel */
  .float-cheats{
    top:calc(var(--sp-5) + 168px + 174px);right:var(--sp-5);width:192px;
  }
  .float-buildcheats{
    top:calc(var(--sp-5) + 216px + 230px);right:var(--sp-5);width:192px;
  }
  .cheat-row{display:flex;align-items:center;gap:var(--sp-2);font-size:11.5px;padding:3px 0;cursor:pointer;}
  .cheat-row input[type=checkbox]{accent-color:var(--accent);cursor:pointer;flex-shrink:0;}
  .cheat-row label{cursor:pointer;user-select:none;}
  .cheat-tag{font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
    color:#fff;background:var(--accent);padding:1px 4px;margin-left:4px;vertical-align:middle;}

  /* Planet nav context menu */
  #planetCtxMenu{display:none;width:200px;z-index:10;}
  #planetCtxMenu button{width:100%;margin-top:6px;}

  /* Nav arrow overlay — drawn on canvas; this is just the text info panel */
  #navArrowPanel{
    position:absolute;bottom:calc(var(--sp-5) + 56px);left:50%;transform:translateX(-50%);
    background:rgba(0,80,0,0.88);border:1px solid #00cc44;color:#ccffcc;
    font-family:var(--font-body);font-size:11.5px;padding:7px 14px;z-index:3;
    display:none;white-space:nowrap;text-align:center;pointer-events:none;
  }
  #navArrowPanel b{color:#00ff66;}

  #controls-bar{
    bottom:var(--sp-5);left:50%;transform:translateX(-50%);
    display:flex;align-items:center;gap:var(--sp-5);flex-wrap:wrap;justify-content:center;max-width:92%;
    padding:var(--sp-3) var(--sp-4);
  }
  .ctl-group{display:flex;align-items:center;gap:var(--sp-2);}
  .ctl-label{font-size:9.5px;color:#666;letter-spacing:.06em;font-weight:700;text-transform:uppercase;}
  .warp-btn{
    background:var(--bg);border:1px solid var(--primary);color:var(--primary);font-family:var(--font-body);
    font-weight:600;font-size:11px;padding:5px 9px;cursor:pointer;border-radius:0;
  }
  .warp-btn:hover{border-color:var(--accent);}
  .warp-btn.active{background:var(--primary);color:var(--bg);border-color:var(--primary);}
  .warp-btn:disabled{opacity:.3;cursor:not-allowed;}
  #engineToggle{
    background:var(--bg);border:1px solid var(--primary);color:var(--primary);font-family:var(--font-body);
    font-size:12px;padding:8px 16px;cursor:pointer;font-weight:700;border-radius:0;
  }
  #engineToggle.on{background:var(--accent);border-color:var(--accent);color:#fff;}
  #engineToggle:disabled{opacity:.4;cursor:not-allowed;}
  #chuteToggle{
    background:var(--bg);border:1px solid var(--primary);color:var(--primary);font-family:var(--font-body);
    font-size:12px;padding:8px 16px;cursor:pointer;font-weight:700;border-radius:0;display:none;
  }
  #chuteToggle.on{background:#2E7D32;border-color:#2E7D32;color:#fff;}
  input[type=range]{width:90px;accent-color:var(--accent);}

  #shipCtxMenu{display:none;width:170px;z-index:10;}
  #shipCtxMenu button{width:100%;margin-top:6px;}

  #toastMsg{
    position:fixed;top:14px;left:50%;transform:translateX(-50%);
    background:var(--primary);color:var(--bg);font-family:var(--font-body);font-weight:600;
    font-size:12px;padding:9px 16px;z-index:50;opacity:0;transition:opacity .3s ease;pointer-events:none;
    max-width:70%;text-align:center;
  }
</style>
</head>
<body>
<div id="app">
  <header id="appHeader">
    <button id="headerCollapseBtn" title="Collapse header">▾ Collapse</button>
    <h1>Spaceflight Sim</h1>
    <div class="header-actions">
      <div class="vol-ctl" title="Music volume">
        <span class="vol-icon" id="volIcon">🔊</span>
        <input type="range" id="volSlider" min="0" max="100" value="35" step="1">
      </div>
      <button class="mode-btn secondary" id="darkModeBtn">🌙 Dark Mode</button>
      <button class="mode-btn secondary" id="toMenuBtn" style="display:none;">☰ Menu</button>
      <button class="mode-btn" id="toBuildBtn" style="display:none;">← Back to Build</button>
    </div>
  </header>

  <div id="screens">
    <!-- MAIN MENU -->
    <div class="screen active" id="menuScreen">
      <div class="menu-wrap">
        <div class="menu-card" id="mainMenuCard">
          <div class="menu-logo">SPACEFLIGHT SIM</div>
          <div class="menu-sub">Original by Rough_Capital1339/CatPrinceHQ2 · Mod by KampfGuy</div>
          <button class="menu-btn primary" id="menuNewWorld">New World</button>
          <button class="menu-btn" id="menuResume">Resume World</button>
          <button class="menu-btn" id="menuMods">Mod Manager</button>
          <button class="menu-btn" id="menuModTemplate">Download JSON Tank Template</button>
          <div class="menu-foot" id="menuSaveInfo">Checking saves…</div>
        </div>
        <!-- New World wizard -->
        <div class="menu-card" id="newWorldPanel" style="display:none;">
          <div class="menu-logo" style="font-size:18px;">Create World</div>
          <label class="mod-row">Name <input id="nwName" class="te-input" style="width:140px;margin-left:auto;" value="My World"></label>
          <label class="mod-row">Mode
            <select id="nwMode" style="margin-left:auto;background:var(--bg);color:var(--primary);border:1px solid var(--primary);">
              <option value="sandbox">Sandbox</option>
              <option value="campaign">Campaign</option>
            </select>
          </label>
          <label class="mod-row">Flag color <input id="nwFlag" type="color" value="#FF4500" style="margin-left:auto;border:none;background:none;"></label>
          <label class="mod-row" id="nwCheatsRow"><input type="checkbox" id="nwCheats" checked> Enable cheats</label>
          <button class="menu-btn primary" id="nwCreate">Create &amp; Play</button>
          <button class="menu-btn" id="nwBack">← Back</button>
        </div>
        <!-- Resume list -->
        <div class="menu-card" id="resumePanel" style="display:none;">
          <div class="menu-logo" style="font-size:18px;">Your Worlds</div>
          <div id="worldList" style="max-height:280px;overflow-y:auto;display:flex;flex-direction:column;gap:8px;"></div>
          <button class="menu-btn" id="resumeBack">← Back</button>
        </div>
        <!-- Mod Manager -->
        <div class="menu-card" id="modPanel" style="display:none;">
          <div class="menu-logo" style="font-size:18px;">Mod Manager</div>
          <div class="menu-sub">Toggle features. Import JSON mods below.</div>
          <label class="mod-row"><input type="checkbox" id="modRealisticTex" checked><span>Realistic textures (mod)</span></label>
          <label class="mod-row"><input type="checkbox" id="modVanillaTex"><span>Vanilla Textures (remaster)</span></label>
          <label class="mod-row"><input type="checkbox" id="modFairings" checked><span>Separator fairings</span></label>
          <label class="mod-row"><input type="checkbox" id="modHeat" checked><span>Atmosphere heating</span></label>
          <div style="font-size:12px;margin-top:8px;">Import JSON mod (.json)</div>
          <input type="file" id="modImportFile" accept=".json,application/json" style="font-size:11px;">
          <div id="importedModsList" style="font-size:11px;margin-top:6px;"></div>
          <button class="menu-btn" id="modBack">← Back</button>
        </div>
      </div>
    </div>

    <!-- BUILD -->
    <div class="screen" id="buildScreen">
      <canvas id="gridCanvas"></canvas>

      <div class="float-panel float-palette" id="palette"><h3>Parts</h3></div>

      <div class="float-panel float-stats" id="statsPanel">
        <h3>Rocket stats</h3>
        <div class="stat-line"><span>Dry mass</span><b id="s-dry">—</b></div>
        <div class="stat-line"><span>Fuel mass</span><b id="s-fuel">—</b></div>
        <div class="stat-line"><span>Total thrust</span><b id="s-thrust">—</b></div>
        <div class="stat-line"><span>Thrust/weight</span><b id="s-twr">—</b></div>
        <div class="stat-line"><span>Est. Δv</span><b id="s-dv">—</b></div>
        <div class="stat-line"><span>Orbit Δv (Earth)</span><b id="s-orbitdv">—</b></div>
        <div class="stat-line" id="moneyLine" style="display:none;"><span>Funds</span><b id="s-money">$0</b></div>
        <div class="warn-text" id="s-warn"></div>
      </div>

      <div class="float-panel float-zoom">
        <button class="icon-btn" id="gridZoomOut" title="Zoom out">–</button>
        <button class="icon-btn" id="gridZoomReset" title="Reset view">⟳</button>
        <button class="icon-btn" id="gridZoomIn" title="Zoom in">+</button>
      </div>

      <div class="float-panel" id="buildActionBar">
        <button class="btn danger" id="clearBtn">Clear rocket</button>
        <button class="btn" id="saveRocketBtn">Save Rocket</button>
        <button class="btn primary" id="launchBtn">Launch ▲</button>
      </div>

      <div class="float-panel float-savedrockets" id="savedRocketsPanel">
        <h3>Saved Rockets</h3>
        <div id="savedRocketsList"></div>
      </div>

      <div class="float-panel float-buildcheats" id="buildCheatsPanel">
        <h3>Cheats <span class="cheat-tag">dev</span></h3>
        <div class="cheat-row">
          <input type="checkbox" id="cheatNoclip">
          <label for="cheatNoclip">Noclip (overlap parts)</label>
        </div>
        <div class="cheat-row">
          <input type="checkbox" id="cheatBigGrid">
          <label for="cheatBigGrid">More Build Space (64×96)</label>
        </div>
      </div>

