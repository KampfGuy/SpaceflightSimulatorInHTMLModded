// nav guidance target planet set text
function drawNavArrow(sh){
  if(!navDeltaV||!navTargetPlanet||!sh) return;
  const tStr=fmtDuration(navDeltaV.interceptT);
  const panel=el('navArrowPanel');

  // countdown to planned burn — burning early just wastes the solved Δv
  const waitLeft=navDeltaV.burnSimTime-simTime;
  if(waitLeft>1){
    const magStr=fmtSpeed(navDeltaV.mag); //format for big numbers (interstellar)
    panel.innerHTML='<b>Nav → '+navTargetPlanet.name+'</b>  '
      +'Coasting — burn in <b>'+fmtDuration(waitLeft)+'</b>  '
      +'(planned Δv: '+magStr+', transfer ~'+tStr+')'
      +'  <span style="font-size:10px;opacity:.7">[click planet again to recompute]</span>';
    panel.style.display='block';
    return; // no arrow yet — nothing to execute right now
  }

  // once burn reads done stay done
  if(navBurnDone){
    panel.innerHTML='<b>Nav → '+navTargetPlanet.name+'</b>  '
      +'<b style="color:#00ff66">On course</b> — burn complete, intercept in ~'+tStr
      +'  <span style="font-size:10px;opacity:.7">[click planet again to recompute]</span>';
    panel.style.display='block';
    return;
  }

  // window open capture absolute velocity re
  if(!navBurnTargetVel){
    navBurnTargetVel={x:sh.vel.x+navDeltaV.dvx, y:sh.vel.y+navDeltaV.dvy};
  }
  const remDvx=navBurnTargetVel.x-sh.vel.x;
  const remDvy=navBurnTargetVel.y-sh.vel.y;
  const remMag=Math.hypot(remDvx,remDvy);
  const origMag=Math.max(navDeltaV.mag,0.001);
  const pctDone=Math.max(0,Math.min(100,100*(1-remMag/origMag)));
  const remStr=fmtSpeed(remMag); //format

  // close enough snap velocity exactly onto
  const BURN_DONE_THRESHOLD=5;
  if(remMag<BURN_DONE_THRESHOLD){
    sh.vel.x=navBurnTargetVel.x; sh.vel.y=navBurnTargetVel.y;
    // first frame burn completes freeze coast
    if(!navBurnDone){
      navBurnDone=true;
      const arrivalT=navDeltaV.burnSimTime+navDeltaV.interceptT;
      navPostBurnCoastPath=computeNavPostBurnCoastPath(sh, simTime, arrivalT, navTargetPlanet);
    }
    panel.innerHTML='<b>Nav → '+navTargetPlanet.name+'</b>  '
      +'<b style="color:#00ff66">On course</b> — burn complete, intercept in ~'+tStr
      +'  <span style="font-size:10px;opacity:.7">[click planet again to recompute]</span>';
    panel.style.display='block';
    return; // no arrow needed — target velocity reached
  }

  const ss=worldToScreen(sh.pos.x,sh.pos.y);

  // remaining delta-v direction, world → screen (Y flipped, camera-rotated)
  const a=camera.angle;
  const cos=Math.cos(a), sin=Math.sin(a);
  // world (dx,dy) → screen (sdx,sdy), Y-flipped and rotated
  const sdx= remDvx*cos + remDvy*sin;
  const sdy= remDvx*sin - remDvy*cos;
  const slen=Math.hypot(sdx,sdy)||1;
  const snx=sdx/slen, sny=sdy/slen;

  // Draw a ring around the ship and the arrow on the ring
  const RING=52;
  const cx=ss.x+snx*RING, cy=ss.y+sny*RING;

  fctx.save();
  // Ring
  fctx.beginPath(); fctx.arc(ss.x,ss.y,RING,0,Math.PI*2);
  fctx.strokeStyle='rgba(0,220,80,0.35)'; fctx.lineWidth=1.2; fctx.stroke();

  // Arrow shaft + head
  const SHAFT=28, HEAD=10;
  fctx.strokeStyle='rgba(0,255,100,0.92)'; fctx.lineWidth=2.5;
  fctx.lineCap='round';
  const bx=cx-snx*SHAFT, by=cy-sny*SHAFT;
  fctx.beginPath(); fctx.moveTo(bx,by); fctx.lineTo(cx,cy); fctx.stroke();
  // Arrowhead
  const perp={x:-sny,y:snx};
  fctx.fillStyle='rgba(0,255,100,0.92)';
  fctx.beginPath();
  fctx.moveTo(cx+snx*HEAD, cy+sny*HEAD);
  fctx.lineTo(cx-snx*6+perp.x*6, cy-sny*6+perp.y*6);
  fctx.lineTo(cx-snx*6-perp.x*6, cy-sny*6-perp.y*6);
  fctx.closePath(); fctx.fill();

  // Magnitude label next to arrow tip — shows what's LEFT to add, live.
  fctx.font='bold 11px sans-serif';
  fctx.textAlign='center'; fctx.textBaseline='middle';
  const labelOff=20;
  const labelX=cx+snx*labelOff, labelY=cy+sny*labelOff;
  const labelText='Δv '+remStr+' left';
  const tw=fctx.measureText(labelText).width;
  fctx.fillStyle='rgba(0,40,0,0.75)';
  fctx.fillRect(labelX-tw/2-4, labelY-8, tw+8, 16);
  fctx.fillStyle='#00ff66';
  fctx.fillText(labelText, labelX, labelY);
  fctx.restore();

  // Update the text info panel below the controls bar with live progress.
  panel.innerHTML='<b>Nav → '+navTargetPlanet.name+'</b>  '
    +'<b>BURN NOW</b> — Δv remaining: <b>'+remStr+'</b> ('+pctDone.toFixed(0)+'% done)  intercept in ~'+tStr
    +'  <span style="font-size:10px;opacity:.7">[click planet again to recompute]</span>';
  panel.style.display='block';
}

function drawShip(sh){
  const s=worldToScreen(sh.pos.x,sh.pos.y);
  const active=sh===activeShip();
  const mpp=camera.metersPerPixel;
  // worldtoscreen flips y applies ccw rotation
  const relAngle=sh.angle+camera.angle;
  if(mpp<6){
    const detailScale=CELL_WORLD/mpp;
    fctx.save();
    fctx.translate(s.x,s.y);
    fctx.rotate(relAngle);
    const dw=sh.sprite.cellsW*detailScale, dh=sh.sprite.cellsH*detailScale;
    fctx.drawImage(sh.sprite.canvas,-sh.sprite.comXc*detailScale,-sh.sprite.comYc*detailScale,dw,dh);
    // Liquid engines: single plume under COM · SRBs: plume under EACH solid booster (KSP-style)
    const engLit=sh.engineOn&&sh.parts.some(pp=>{
      const t=PARTS[pp.id]&&PARTS[pp.id].type;
      return (t==='engine'||t==='jet')&&sh.engineEnabled[pp.uid]!==false;
    });
    if(engLit){
      const bottomY=(sh.sprite.cellsH-sh.sprite.comYc)*detailScale;
      const thr=Math.max(0.15, sh.throttle||1);
      const flicker=0.85+Math.random()*0.35;
      const flameLen=1.4*(0.85+Math.random()*0.5)*detailScale*thr*flicker;
      const halfW=0.42*detailScale*thr;
      fctx.fillStyle='rgba(255,90,20,0.55)';
      fctx.beginPath(); fctx.moveTo(-halfW*1.3,bottomY); fctx.lineTo(halfW*1.3,bottomY); fctx.lineTo(0,bottomY+flameLen*1.15); fctx.closePath(); fctx.fill();
      fctx.fillStyle='rgba(255,170,40,0.85)';
      fctx.beginPath(); fctx.moveTo(-halfW*0.75,bottomY); fctx.lineTo(halfW*0.75,bottomY); fctx.lineTo(0,bottomY+flameLen*0.85); fctx.closePath(); fctx.fill();
      fctx.fillStyle='rgba(255,255,220,0.95)';
      fctx.beginPath(); fctx.moveTo(-halfW*0.28,bottomY); fctx.lineTo(halfW*0.28,bottomY); fctx.lineTo(0,bottomY+flameLen*0.45); fctx.closePath(); fctx.fill();
    }
    // Per-SRB exhaust at the bottom of each solid booster part
    if(sh.engineOn&&sh.sprite){
      const minC=Math.min(...sh.parts.map(pp=>pp.col));
      const minR=Math.min(...sh.parts.map(pp=>pp.row));
      sh.parts.forEach(pp=>{
        const d=PARTS[pp.id]; if(!d||d.type!=='srb') return;
        if((sh.tankFuel[pp.uid]||0)<=0) return;
        const eff=effDims(pp.id, partRot(pp));
        // local sprite coords relative to COM
        const lx=(pp.col-minC+eff.w/2 - sh.sprite.comXc)*detailScale;
        const botY=(pp.row-minR+eff.h - sh.sprite.comYc)*detailScale;
        const flicker=0.85+Math.random()*0.4;
        const flameLen=(2.2+Math.random()*0.9)*detailScale*flicker;
        const halfW=0.55*detailScale*(eff.w/2);
        fctx.fillStyle='rgba(255,50,5,0.55)';
        fctx.beginPath(); fctx.moveTo(lx-halfW*1.3,botY); fctx.lineTo(lx+halfW*1.3,botY); fctx.lineTo(lx,botY+flameLen*1.15); fctx.closePath(); fctx.fill();
        fctx.fillStyle='rgba(255,150,30,0.9)';
        fctx.beginPath(); fctx.moveTo(lx-halfW*0.8,botY); fctx.lineTo(lx+halfW*0.8,botY); fctx.lineTo(lx,botY+flameLen*0.9); fctx.closePath(); fctx.fill();
        fctx.fillStyle='rgba(255,255,210,0.95)';
        fctx.beginPath(); fctx.moveTo(lx-halfW*0.3,botY); fctx.lineTo(lx+halfW*0.3,botY); fctx.lineTo(lx,botY+flameLen*0.45); fctx.closePath(); fctx.fill();
        for(let i=0;i<5;i++){
          fctx.fillStyle='rgba(255,'+(160+Math.random()*80|0)+',40,0.9)';
          fctx.fillRect(lx+(Math.random()-0.5)*halfW*2, botY+Math.random()*flameLen, 1.3, 2+Math.random()*4);
        }
      });
    }
    if(sh.chuteDeployed){
      fctx.strokeStyle='rgba(230,230,230,0.85)';
      fctx.lineWidth=Math.max(1,detailScale*0.06);
      const topY=-sh.sprite.comYc*detailScale-detailScale*1.4;
      fctx.beginPath(); fctx.arc(0,topY,detailScale*1.6,Math.PI*0.15,Math.PI*0.85); fctx.stroke();
      fctx.beginPath(); fctx.moveTo(-detailScale*1.5,topY-detailScale*0.2); fctx.lineTo(-detailScale*0.3,-sh.sprite.comYc*detailScale); fctx.stroke();
      fctx.beginPath(); fctx.moveTo(detailScale*1.5,topY-detailScale*0.2); fctx.lineTo(detailScale*0.3,-sh.sprite.comYc*detailScale); fctx.stroke();
    }
    fctx.restore();
  } else if(mpp<400){
    fctx.save(); fctx.translate(s.x,s.y); fctx.rotate(relAngle);
    fctx.fillStyle=active?'#FF4500':'#999';
    fctx.beginPath(); fctx.moveTo(0,-7); fctx.lineTo(5,6); fctx.lineTo(-5,6);
    fctx.closePath(); fctx.fill();
    fctx.restore();
    if(!active){ fctx.fillStyle='rgba(255,255,255,0.6)'; fctx.font='10px sans-serif'; fctx.fillText(sh.name,s.x+9,s.y-9); }
  } else {
    fctx.fillStyle=active?'#FF4500':'#999';
    fctx.beginPath(); fctx.arc(s.x,s.y,2.5,0,Math.PI*2); fctx.fill();
  }

  // Draw mouse-pull indicator when cheat is active for this ship
  if(active&&cheats.mousePull&&flightMouseDown){
    const wmouse=screenToWorld(flightMousePos.x,flightMousePos.y);
    const ms=worldToScreen(wmouse.x,wmouse.y);
    fctx.save();
    fctx.strokeStyle='rgba(255,200,0,0.7)';
    fctx.lineWidth=1.5;
    fctx.setLineDash([4,4]);
    fctx.beginPath(); fctx.moveTo(s.x,s.y); fctx.lineTo(ms.x,ms.y); fctx.stroke();
    fctx.setLineDash([]);
    fctx.fillStyle='rgba(255,200,0,0.9)';
    fctx.beginPath(); fctx.arc(ms.x,ms.y,4,0,Math.PI*2); fctx.fill();
    fctx.restore();
  }
}

// visual atmosphere depth background tint star
function getAtmoDensity(pos,p){
  const ppos=planetPositionAt(p,simTime);
  const rdist=Math.hypot(pos.x-ppos.x,pos.y-ppos.y);
  if(!p.atmo) return 0;
  if(p.solid){
    const top=p.radius*(1+(p.atmoFrac||0));
    if(rdist>=top) return 0;
    const depth=Math.max(0,Math.min(1,(top-rdist)/(top-p.radius)));
    return Math.pow(depth,1.4);
  } else {
    if(rdist>=p.radius) return 0;
    const depth=1-rdist/p.radius;
    return Math.min(1,depth*1.4);
  }
}

// culls overlapping bodies at extreme zoom-out, keeps the biggest
const OVERLAP_CULL_PX = 3;
function cullOverlappingBodies(){
  const items=ALL_BODIES.map(b=>{
    const pos=planetPositionAt(b,simTime);
    const s=worldToScreen(pos.x,pos.y);
