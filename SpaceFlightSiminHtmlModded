// ============================================================
// PHYSICS
// ============================================================
function destroyShip(f,reason){
  f.status='crashed'; f.statusMsg=reason; f.engineOn=false; f._pendingRemoval=true;
  if(f._isBeaconClone) return; // no UI side-effects for prediction clones
  shipListDirty=true;
  if(f===activeShip()) updateEngineBtn();
  showToast(reason);
}

// fires every individually enabled engine still
function fireEnginesAndDrainFuel(f,dt){
  if(!f.engineOn) return 0;
  let totalThrust=0;
  f.parts.forEach(pp=>{
    const d=PARTS[pp.id];
    if(!d) return;
    const isLiq=d.type==='engine'||d.type==='prop'||d.type==='shipprop';
    const isSrb=d.type==='srb';
    if(!isLiq&&!isSrb) return;
    if(f.engineEnabled[pp.uid]===false) return;
    // SRBs burn their own solid grain at full thrust (no throttle)
    if(isSrb){
      // Prefer attached solid-fuel blocks, then the SRB's own grain
      const tankUids=f.engineConnections[pp.uid]||[];
      const solidUids=tankUids.filter(tid=>{
        const part=f.parts.find(p=>p.uid===tid);
        return part&&PARTS[part.id]&&PARTS[part.id].type==='solidfuel';
      });
      let have=cheats.infiniteFuel?Infinity:0;
      if(!cheats.infiniteFuel){
        if(solidUids.length) solidUids.forEach(tid=>{ have+=(f.tankFuel[tid]||0); });
        else have=f.tankFuel[pp.uid]||0;
      }
      if(have<=0) return;
      totalThrust+=d.thrust;
      f._srbBurning=true;
      if(!cheats.infiniteFuel){
        let need=d.fuelRate*dt;
        if(solidUids.length){
          for(const tid of solidUids){
            if(need<=0) break;
            const hv=f.tankFuel[tid]||0;
            const take=Math.min(hv,need);
            f.tankFuel[tid]=hv-take; need-=take;
          }
        } else {
          f.tankFuel[pp.uid]=Math.max(0,(f.tankFuel[pp.uid]||0)-need);
        }
      }
      return;
    }
    const tankUids=f.engineConnections[pp.uid]||[];
    // jet engines prefer jet fuel tanks
    let available=cheats.infiniteFuel?Infinity:tankUids.reduce((sum,tid)=>sum+(f.tankFuel[tid]||0),0);
    if(available<=0) return;
    // props/jets only work in atmosphere
    if((d.planeOnly||d.type==='prop')&&!f._inAtmo) return;
    if(d.shipOnly&&!isOverFluid(f)) return;
    const thrMul=(d.type==='prop'||d.type==='shipprop')?1:f.throttle;
    totalThrust+=d.thrust*thrMul;
    if(!cheats.infiniteFuel){
      let need=Math.min(d.fuelRate*thrMul*dt,available);
      for(const tid of tankUids){
        if(need<=0) break;
        const have=f.tankFuel[tid]||0;
        const take=Math.min(have,need);
        f.tankFuel[tid]=have-take; need-=take;
      }
    }
  });
  if(!cheats.infiniteFuel){
    f.fuel=Object.values(f.tankFuel).reduce((a,b)=>a+b,0);
    // auto off when nothing left to burn
    const anyReachableFuel=f.parts.some(pp=>{
      const t=PARTS[pp.id]&&PARTS[pp.id].type;
      if(t==='srb') return (f.tankFuel[pp.uid]||0)>0;
      if(t!=='engine'&&t!=='prop'&&t!=='shipprop') return false;
      const tankUids=f.engineConnections[pp.uid]||[];
      return tankUids.some(tid=>(f.tankFuel[tid]||0)>0);
    });
    if(!anyReachableFuel){
      f.engineOn=false; if(f===activeShip()) updateEngineBtn();
      // No suborbital-doom flight check — just coast
      if(f===activeShip()&&!f._fuelEmptyWarned){
        f._fuelEmptyWarned=true;
        showToast('Out of fuel.');
      }
    }
  }
  return totalThrust;
}

// WASD strafe via RCS — independent of main engine, active ship only
function fireRCS(f,dt){
  if(f.status!=='flying') return {ax:0,ay:0};
  let fx=0, fy=0;
  if(keys['w']) fy+=1;
  if(keys['s']) fy-=1;
  if(keys['a']) fx-=1;
  if(keys['d']) fx+=1;
  if(!fx&&!fy) return {ax:0,ay:0};
  const mag=Math.hypot(fx,fy); fx/=mag; fy/=mag;
  let totalThrust=0;
  f.parts.forEach(pp=>{
    const d=PARTS[pp.id];
    if(d.type!=='rcs') return;
    const tankUids=f.engineConnections[pp.uid]||[];
    const available=cheats.infiniteFuel?Infinity:tankUids.reduce((s,tid)=>s+(f.tankFuel[tid]||0),0);
    if(available<=0) return;
    totalThrust+=d.thrust;
    if(!cheats.infiniteFuel){
      let need=Math.min(d.fuelRate*dt,available);
      for(const tid of tankUids){
        if(need<=0) break;
        const have=f.tankFuel[tid]||0;
        const take=Math.min(have,need);
        f.tankFuel[tid]=have-take; need-=take;
      }
    }
  });
  if(totalThrust<=0) return {ax:0,ay:0};
  if(!cheats.infiniteFuel) f.fuel=Object.values(f.tankFuel).reduce((a,b)=>a+b,0);
  const accel=totalThrust/Math.max(1, f.dryMass+f.fuel);
  const fwdX=Math.sin(f.angle), fwdY=Math.cos(f.angle);
  const sideX=Math.cos(f.angle), sideY=-Math.sin(f.angle);
  return {ax:(fwdX*fy+sideX*fx)*accel, ay:(fwdY*fy+sideY*fx)*accel};
}

// Cone parts mounted flush against a tank, and heat shields, reduce atmospheric drag
function shipDragMult(f){
  let m=1;
  f.parts.forEach(pp=>{
    const d=PARTS[pp.id];
    if(d.type==='heatshield' && d.dragMult){ m*=d.dragMult; return; }
    if(d.type!=='cone') return;
    const onTank=f.parts.some(o=>PARTS[o.id].type==='tank'&&footprintsTouch(pp,o));
    if(onTank) m*=d.dragMult;
  });
  return m;
}

//prevent clipping through solid planets
function checkTunnelCollisions(f,domBody,tNew){
  for(const p of PLANETS){
    if(!p.solid||p===domBody) continue;
    const ppos=planetPositionAt(p,tNew);
    const d=Math.hypot(f.pos.x-ppos.x,f.pos.y-ppos.y);
    const foot=shipFootOffset(f);
    const groundR=p.radius+foot;
    if(d<=groundR){
      const nx=(f.pos.x-ppos.x)/(d||1), ny=(f.pos.y-ppos.y)/(d||1);
      f.pos.x=ppos.x+nx*groundR; f.pos.y=ppos.y+ny*groundR;
      const pVelNew=planetVelocityAt(p,tNew);
      const relSpeed=Math.hypot(f.vel.x-pVelNew.x,f.vel.y-pVelNew.y);
      if(relSpeed<=SAFE_LANDING_SPEED){
        f.status='landed'; f.statusMsg='Landed safely on '+p.name+'.'; shipListDirty=true;
        f.landedOnPlanet=p; f.landedRelPos={x:nx*groundR,y:ny*groundR};
        f.vel.x=pVelNew.x; f.vel.y=pVelNew.y;
        f.engineOn=false; if(f===activeShip()) updateEngineBtn();
      } else {
        destroyShip(f,f.name+' was destroyed on impact with '+p.name+' at '+relSpeed.toFixed(0)+' m/s.');
      }
      return;
    }
  }
}
function integrate(f,dt,t){
  const mass=Math.max(1, f.dryMass+f.fuel); // never divide by zero
  if(!isFinite(dt) || dt<=0) return;
  const dom=findDominantBody(f.pos,t);
  // Are we the active ship and mouse-pull cheat is on?
  const isActive=f===activeShip();
  const doPull=cheats.mousePull&&flightMouseDown&&isActive;

  if(dom){
    const pVel=planetVelocityAt(dom.p,t);
    let rx=f.pos.x-dom.ppos.x,  ry=f.pos.y-dom.ppos.y;
    let rvx=f.vel.x-pVel.x,     rvy=f.vel.y-pVel.y;
    const rdist=Math.hypot(rx,ry)||1;
    const gMag=dom.p.GM/(rdist*rdist);
    let rax=-gMag*rx/rdist;
    let ray=-gMag*ry/rdist;
    f._domBody=dom.p;

    // atmosphere drag density artificial function depth
    let inAtmo=false;
    if(dom.p.atmo){
      let density=0;
      if(dom.p.solid){
        const top=dom.p.radius*(1+dom.p.atmoFrac);
        if(rdist<top){
          const depth=Math.max(0,Math.min(1,(top-rdist)/(top-dom.p.radius)));
          density=Math.pow(depth,1.6); inAtmo=true;
        }
      } else if(rdist<dom.p.radius){
        const depth=1-(rdist/dom.p.radius);
        density=Math.min(1,depth*1.4); inAtmo=true;
        if(depth>GAS_GIANT_CRUSH_DEPTH){
          destroyShip(f,f.name+' was crushed deep in '+dom.p.name+'\u2019s atmosphere.');
          return;
        }
      }
      if(density>0){
        let dragK=ATMO_DRAG_K*density*shipDragMult(f);
        if(f.chuteDeployed) dragK*=PARACHUTE_DRAG_MULT;
        // Clamp the exponent so a single large warp step can't zero velocity
        // (that was causing 5× warp to kill all speed then crash into the planet)
        const decay=Math.exp(-Math.min(dragK*dt, 3.5));
        rvx*=decay; rvy*=decay;
      }
    }
    f._inAtmo=inAtmo;

    // —— Water / methane physics (Earth oceans, Titan lakes) ——
    f._inWater=false;
    const fluid=bodyHasSurfaceFluid(dom.p);
    if(fluid&&fluid!=='icewater'&&dom.p.solid){
      const footW=shipFootOffset(f);
      const waterline=dom.p.radius; // surface is the waterline
      const sub=waterline+footW-rdist; // >0 means keel below waterline
      if(sub>-3){
        const hasHull=f.parts.some(pp=>PARTS[pp.id]&&PARTS[pp.id].buoyant);
        f._inWater=sub>0;
        if(hasHull){
          // Archimedes: buoyancy grows with submersion, slightly > weight when deep so ship settles at waterline
          const fill=Math.max(0,Math.min(1.4, (sub+2)/12));
          const buoy=gMag*(0.35+1.0*fill);
          rax+=buoy*rx/rdist;
          ray+=buoy*ry/rdist;
          // strong hydrodynamic drag
          const wDrag=Math.exp(-Math.min((4+10*fill)*dt, 5));
          rvx*=wDrag; rvy*=wDrag;
        } else if(sub>0){
          // no hull — water resistance, still sinks under gravity
          const wDrag=Math.exp(-Math.min(2.5*dt, 3));
          rvx*=wDrag; rvy*=wDrag;
        }
      }
    }

    // Engine thrust — each enabled engine draws only from its connected tank(s)
    const activeThrust=fireEnginesAndDrainFuel(f,dt);
    if(activeThrust>0){
      const thrustAccel=(activeThrust*f.throttle)/mass;
      rax+=thrustAccel*Math.sin(f.angle);
      ray+=thrustAccel*Math.cos(f.angle);
    }

    // RCS translate thrust (WASD)
    if(isActive){
      const rcsA=fireRCS(f,dt);
      rax+=rcsA.ax; ray+=rcsA.ay;
    }

    //Mouse pull had to be changed a bit with the moon update so this should fix the ray
    if(doPull){
      const wmouse=screenToWorld(flightMousePos.x,flightMousePos.y);
      const dmx=wmouse.x-f.pos.x, dmy=wmouse.y-f.pos.y;
      const dist=Math.hypot(dmx,dmy)||1;
      rax+=MOUSE_PULL_ACCEL*dmx/dist;
      ray+=MOUSE_PULL_ACCEL*dmy/dist;
    }

    rvx+=rax*dt; rvy+=ray*dt;
    rx+=rvx*dt; ry+=rvy*dt;

    const pPosNew=planetPositionAt(dom.p,t+dt);
    const pVelNew=planetVelocityAt(dom.p,t+dt);
    f.pos.x=pPosNew.x+rx; f.pos.y=pPosNew.y+ry;
    f.vel.x=pVelNew.x+rvx; f.vel.y=pVelNew.y+rvy;

    if(Math.hypot(f.pos.x,f.pos.y)<=SUN_RADIUS){
      destroyShip(f,f.name+' was vaporized by the Sun.'); return;
    }

    // Landing / crash / splashdown
    if(dom.p.solid){
      const newRdist=Math.hypot(rx,ry);
      const foot=shipFootOffset(f);
      const groundR=dom.p.radius+foot;
      if(newRdist<=groundR){
        const nx=rx/(newRdist||1), ny=ry/(newRdist||1);
        const hasHull=f.parts.some(pp=>PARTS[pp.id]&&PARTS[pp.id].buoyant);
        const fluid=bodyHasSurfaceFluid(dom.p);
        // Hull craft float at waterline instead of hard-landing through the ocean
        if(hasHull&&fluid&&fluid!=='icewater'){
          f.pos.x=pPosNew.x+nx*groundR;
          f.pos.y=pPosNew.y+ny*groundR;
          f.vel.x=pVelNew.x; f.vel.y=pVelNew.y;
          f.status='landed';
          f.statusMsg='Floating on '+(fluid==='methane'?'methane':'water')+' — '+dom.p.name;
          f.landedOnPlanet=dom.p;
          f.landedRelPos={x:nx*groundR, y:ny*groundR};
          f._inWater=true;
          f.engineOn=false; if(f===activeShip()) updateEngineBtn();
          shipListDirty=true;
          return;
        }
        f.pos.x=pPosNew.x+nx*groundR;
        f.pos.y=pPosNew.y+ny*groundR;
        const relSpeed=Math.hypot(rvx,rvy);
        if(relSpeed<=SAFE_LANDING_SPEED){
          f.status='landed'; f.statusMsg='Landed safely on '+dom.p.name+'.'; shipListDirty=true;
          f.landedOnPlanet=dom.p;
          f.landedRelPos={x:nx*groundR, y:ny*groundR};
          f.vel.x=pVelNew.x; f.vel.y=pVelNew.y;
          f.engineOn=false; if(f===activeShip()) updateEngineBtn();
        } else {
          destroyShip(f,f.name+' was destroyed on impact with '+dom.p.name+' at '+relSpeed.toFixed(0)+' m/s.');
        }
        return;
      }
    } else {
      checkTunnelCollisions(f,dom.p,t+dt);
      if(f._pendingRemoval) return;
    }

  } else {
    //Beyond sun you have no soi, this is new because sun soi used to be infinite.
    f._domBody=null; f._inAtmo=false;
    let ax=0, ay=0;

    const activeThrustIP=fireEnginesAndDrainFuel(f,dt);
    if(activeThrustIP>0){
      const thrustAccel=(activeThrustIP*f.throttle)/mass;
      ax+=thrustAccel*Math.sin(f.angle);
      ay+=thrustAccel*Math.cos(f.angle);
    }

    if(isActive){
      const rcsA=fireRCS(f,dt);
      ax+=rcsA.ax; ay+=rcsA.ay;
    }

    // Mouse-pull cheat
    if(doPull){
      const wmouse=screenToWorld(flightMousePos.x,flightMousePos.y);
      const dmx=wmouse.x-f.pos.x, dmy=wmouse.y-f.pos.y;
      const dist=Math.hypot(dmx,dmy)||1;
      ax+=MOUSE_PULL_ACCEL*dmx/dist;
      ay+=MOUSE_PULL_ACCEL*dmy/dist;
    }

    f.vel.x+=ax*dt; f.vel.y+=ay*dt;
    f.pos.x+=f.vel.x*dt; f.pos.y+=f.vel.y*dt;
  }
}

//sun uses legit radius for colliding instead of weird calculation claude code did for gas giants like 87 years ago
function domSurfaceGap(dom){
  const shrink=(dom.p===SUN_BODY)?dom.p.radius:(dom.p.solid?dom.p.radius:dom.p.radius*0.3);
  return Math.max(1,dom.dist-shrink);
}
//Substep optimization when not in sun SOI
function domSubstepCap(dom){
  return (dom&&dom.p!==SUN_BODY)?SUBSTEP_DT_MAX_SOI:SUBSTEP_DT_MAX_INTERP;
}
// Even tighter steps while inside an atmosphere so 5× warp doesn't tunnel or zero velocity
function atmoSubstepCap(){ return 8; }

// adaptive substep sizing aim cross half
const SUBSTEP_NEAREST_FRACTION = 0.5;
const SUBSTEP_DT_MAX_INTERP = 2000; // generous cap far from all bodies
const SUBSTEP_DT_MAX_SOI     = 150;  // tight cap inside a planet SOI for accuracy
const SUBSTEP_DT_MIN = 0.002;
function stepSimSeconds(f,simSeconds,tStart,maxSubstepDtOverride){
  if(!isFinite(simSeconds) || simSeconds<=0) return;
  // Guard against NaN ship state from a previous bad frame
  if(!isFinite(f.pos.x) || !isFinite(f.pos.y) || !isFinite(f.vel.x) || !isFinite(f.vel.y)){
    f.status='crashed'; f.statusMsg=f.name+' left the known universe (NaN physics).';
    f._pendingRemoval=true; return;
  }
  let remaining=simSeconds, t=tStart, steps=0;
  // At high warp, raise the floor on dt so we don't burn 2500 micro-steps
  // near a surface and freeze the tab. Accuracy trades off for stability.
  const highWarpFloor = simSeconds > 50 ? Math.min(simSeconds/400, 2) : SUBSTEP_DT_MIN;
  const stepBudget = simSeconds > 200 ? Math.min(MAX_SUBSTEPS_PER_FRAME, 800)
                    : simSeconds > 20  ? Math.min(MAX_SUBSTEPS_PER_FRAME, 1500)
                    : MAX_SUBSTEPS_PER_FRAME;
  while(remaining>1e-6 && steps<stepBudget && f.status==='flying'){
    const dom=findDominantBody(f.pos,t);
    let maxDt=maxSubstepDtOverride!==undefined?maxSubstepDtOverride:domSubstepCap(dom);
    // Atmosphere needs much smaller steps or 5× warp tunnels / kills velocity
    if(f._inAtmo) maxDt=Math.min(maxDt, atmoSubstepCap());
    const nearest=dom
      ?domSurfaceGap(dom)
      :Math.max(1,Math.hypot(f.pos.x-SUN_POS.x,f.pos.y-SUN_POS.y)-SUN_RADIUS);
    let relVx=f.vel.x, relVy=f.vel.y;
    if(dom){ const pv=planetVelocityAt(dom.p,t); relVx-=pv.x; relVy-=pv.y; }
    const speed=Math.max(1,Math.hypot(relVx,relVy));
    let capDt=Math.min(maxDt,(nearest/speed)*SUBSTEP_NEAREST_FRACTION);
    if(!isFinite(capDt) || capDt<=0) capDt=maxDt;
    // Don't force a high floor inside atmosphere — that caused the 5× crash
    const floor=f._inAtmo ? SUBSTEP_DT_MIN : highWarpFloor;
    const dt=Math.min(remaining, Math.max(capDt, floor));
    if(!isFinite(dt) || dt<=0) break;
    integrate(f,dt,t);
    // Bail if integrate produced NaNs
    if(!isFinite(f.pos.x) || !isFinite(f.pos.y) || !isFinite(f.vel.x) || !isFinite(f.vel.y)){
      f.status='crashed'; f.statusMsg=f.name+' hit a numerical singularity.';
      f._pendingRemoval=true; return;
    }
    t+=dt; remaining-=dt; steps++;
  }
}

