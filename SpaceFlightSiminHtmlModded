  });
  const keep=new Set(ALL_BODIES);
  for(let i=0;i<items.length;i++){
    const a=items[i];
    if(!keep.has(a.b)) continue;
    for(let j=i+1;j<items.length;j++){
      const c=items[j];
      if(!keep.has(c.b)) continue;
      if(Math.hypot(a.x-c.x,a.y-c.y)>OVERLAP_CULL_PX) continue;
