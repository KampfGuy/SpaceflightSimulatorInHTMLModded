  if(!seps.length&&!engines.length){ panel.style.display='none'; return; }
  panel.style.display='block';
  title.textContent=seps.length&&engines.length?'Staging & Engines':(engines.length?'Engines':'Staging');
  wrap.innerHTML='';
  seps.forEach((idx,n)=>{
    const pp=sh.parts[idx];
    const isSide=PARTS[pp.id].type==='sidesep';
    const row=document.createElement('div');
    row.className='stage-row';
    row.innerHTML='<span>'+(isSide?'Side Sep ':'Separator ')+(n+1)+'</span>';
    const btn=document.createElement('button');
    btn.className='btn small danger'; btn.textContent='Activate';
    btn.onclick=()=>activateSeparator(sh,idx);
    row.appendChild(btn); wrap.appendChild(row);
  });
  if(engines.length){
    if(seps.length){
      const hr=document.createElement('div');
      hr.style.cssText='border-top:1px solid var(--secondary);margin:6px 0;';
      wrap.appendChild(hr);
    }
    engines.forEach((pp,n)=>{
      const enabled=sh.engineEnabled[pp.uid]!==false;
      const row=document.createElement('div');
      row.className='stage-row engine-row';
      row.innerHTML='<span>Engine '+(n+1)+'</span>';
      const btn=document.createElement('button');
      btn.className='btn small'+(enabled?'':' danger');
      btn.textContent=enabled?'ON':'OFF';
      btn.title='Click to '+(enabled?'disable':'enable')+' this engine';
      btn.onclick=()=>{ sh.engineEnabled[pp.uid]=!enabled; renderStagingList(); };
      row.appendChild(btn); wrap.appendChild(row);
    });
  }
}
function activateSeparator(ship,sepIdx){
  const sepPP=ship.parts[sepIdx];
  const sepDef=PARTS[sepPP.id];
  const sepFp=placedFootprint(sepPP);
  const isSide=sepDef.type==='sidesep';
  let keep, discarded;
  if(isSide){
    // split left / right by column center
    const sepCenterCol=sepFp.col+sepFp.w/2;
    const left=[], right=[];
    ship.parts.forEach((pp,i)=>{
      if(i===sepIdx) return;
      const fp=placedFootprint(pp);
      const center=fp.col+fp.w/2;
      (center<sepCenterCol?left:right).push(pp);
    });
    const leftPods=left.filter(pp=>PARTS[pp.id].type==='pod').length;
    const rightPods=right.filter(pp=>PARTS[pp.id].type==='pod').length;
    keep=rightPods>leftPods?right:left;
    discarded=ship.parts.length-1-keep.length;
  } else {
    // classic top / bottom split by row
    const sepCenterRow=sepFp.row+sepFp.h/2;
    const top=[], bottom=[];
    ship.parts.forEach((pp,i)=>{
      if(i===sepIdx) return;
      const fp=placedFootprint(pp);
      const center=fp.row+fp.h/2;
      (center<sepCenterRow?top:bottom).push(pp);
    });
    const topPods=top.filter(pp=>PARTS[pp.id].type==='pod').length;
    const bottomPods=bottom.filter(pp=>PARTS[pp.id].type==='pod').length;
    keep=bottomPods>topPods?bottom:top;
    discarded=ship.parts.length-1-keep.length;
  }
  ship.parts=keep;
  if(!ship.parts.length){ destroyShip(ship,ship.name+' had no parts left after staging.'); return; }
  recomputeShipFromParts(ship);
  showToast(ship.name+': staged — '+discarded+' part(s) jettisoned.');
  renderStagingList(); renderFuelList(); updateChuteBtn(); saveShips();
}

