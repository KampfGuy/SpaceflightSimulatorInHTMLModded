// Spacebar: auto-stage next separator (bottom-most first), else toggle engine
function handleSpacebar(){
  const sh=activeShip();
  if(!sh) return;
  // Launch from pad with space
  if(sh.status==='landed'){
    toggleEngine();
    return;
  }
  if(sh.status!=='flying') return;
  // Find remaining separators / side-seps — stage the bottom-most (highest row) first
  const stageParts=[];
  sh.parts.forEach((pp,i)=>{
    const t=PARTS[pp.id].type;
    if(t==='separator'||t==='sidesep'){
      const fp=placedFootprint(pp);
      stageParts.push({idx:i, row:fp.row+fp.h/2, col:fp.col+fp.w/2});
    }
  });
  if(stageParts.length){
    // Prefer horizontal seps by row (bottom first); side seps by col as tiebreak
    stageParts.sort((a,b)=> b.row-a.row || a.col-b.col);
    if(warp>1) setWarp(1);
    activateSeparator(sh, stageParts[0].idx);
    // After staging, turn engines back on if any remain
    if(sh.parts.some(pp=>PARTS[pp.id].type==='engine')){
      sh.engineOn=true;
      updateEngineBtn();
    }
    return;
  }
  // No stages left — normal engine toggle
  toggleEngine();
}
