window.addEventListener('mousemove',e=>{
  if(!panState) return;
  const dx=e.clientX-panState.startX, dy=e.clientY-panState.startY;
  if(!panState.moved && Math.hypot(dx,dy)>5) panState.moved=true;
  if(panState.moved||panState.button===1){
    const cellPx=BASE_CELL*gridCam.zoom;
    gridCam.x=panState.camX-dx/cellPx;
    gridCam.y=panState.camY-dy/cellPx;
    clampGridCam(); drawGrid();
  }
});
window.addEventListener('mouseup',e=>{
  flightMouseDown=false;
  if(!panState) return;
  if(!panState.moved && panState.button===0){
    const {col,row}=cellFromEvent(e);
    const eff=effDims(selectedPartId,selectedRot);
    const c=Math.min(Math.max(col,0),COLS-eff.w), r=Math.min(Math.max(row,0),ROWS-eff.h);
    if(canPlace(selectedPartId,c,r,selectedRot)){
      placedParts.push({id:selectedPartId,col:c,row:r,uid:partUidCounter++,rot:selectedRot});
      recomputeSeparatorAutosize();
      updateStats();
    }
  }
  panState=null; drawGrid();
});
gridCanvas.addEventListener('contextmenu',e=>{
  e.preventDefault();
  if(mode!=='build') return;
  const {col,row}=cellFromEvent(e);
  for(let i=placedParts.length-1;i>=0;i--){
    const pp=placedParts[i]; const fp=placedFootprint(pp);
    if(col>=fp.col&&col<fp.col+fp.w&&row>=fp.row&&row<fp.row+fp.h){
      placedParts.splice(i,1); recomputeSeparatorAutosize(); updateStats(); drawGrid(); break;
    }
  }
});
// ---------- Rotate (R key): rotates hovered placed part, else the ghost/preview ----------
window.addEventListener('keydown',e=>{
  if(mode!=='build') return;
  if(e.key.toLowerCase()!=='r') return;
  const tag=(document.activeElement&&document.activeElement.tagName)||'';
  if(tag==='INPUT'||tag==='TEXTAREA') return;
  e.preventDefault();
  if(hoverCell){
    for(let i=placedParts.length-1;i>=0;i--){
      const pp=placedParts[i]; const fp=placedFootprint(pp);
      if(hoverCell.col>=fp.col&&hoverCell.col<fp.col+fp.w&&hoverCell.row>=fp.row&&hoverCell.row<fp.row+fp.h){
        const newRot=(partRot(pp)+90)%360;
        const eff=effDims(pp.id,newRot);
        // re-anchor around center so it rotates in place, not from a corner
        const oldEff=effDims(pp.id,partRot(pp));
        const cx=pp.col+oldEff.w/2, cy=pp.row+oldEff.h/2;
        const newCol=Math.round(cx-eff.w/2), newRow=Math.round(cy-eff.h/2);
        const others=placedParts.filter(o=>o.uid!==pp.uid);
        const savedCol=pp.col,savedRow=pp.row,savedRot=pp.rot;
        pp.col=newCol; pp.row=newRow; pp.rot=newRot;
        // validate against other parts, not placedParts (would false-flag itself)
        let valid = newCol>=0&&newRow>=0&&newCol+eff.w<=COLS&&newRow+eff.h<=ROWS;
        if(valid && PARTS[pp.id].type==='dock'){
          const openDir=newRot, mountDir=(newRot+180)%360;
          const mounted=dirHullAdjacent(others,newCol,newRow,eff.w,eff.h,mountDir);
          const openBlocked=dirHullAdjacent(others,newCol,newRow,eff.w,eff.h,openDir);
          valid = mounted&&!openBlocked;
        }
        if(valid && !cheats.buildNoclip){
          const fp2={col:newCol,row:newRow,w:eff.w,h:eff.h};
          for(const o of others){ if(rectsOverlap(fp2,placedFootprint(o))){ valid=false; break; } }
        }
        if(valid){ updateStats(); }
        else { pp.col=savedCol; pp.row=savedRow; pp.rot=savedRot; showToast('Can\'t rotate there.'); }
        drawGrid();
        return;
      }
    }
  }
  selectedRot=(selectedRot+90)%360;
  drawGrid();
});
gridCanvas.addEventListener('wheel',e=>{
  e.preventDefault();
  const rect=gridCanvas.getBoundingClientRect();
  const mx=e.clientX-rect.left, my=e.clientY-rect.top;
  const beforeCellPx=BASE_CELL*gridCam.zoom;
  const gx=gridCam.x+(mx-rect.width/2)/beforeCellPx;
  const gy=gridCam.y+(my-rect.height/2)/beforeCellPx;
  const factor=e.deltaY>0?1/1.15:1.15;
  gridCam.zoom=Math.max(GRID_MIN_ZOOM,Math.min(GRID_MAX_ZOOM,gridCam.zoom*factor));
  const afterCellPx=BASE_CELL*gridCam.zoom;
  gridCam.x=gx-(mx-rect.width/2)/afterCellPx;
  gridCam.y=gy-(my-rect.height/2)/afterCellPx;
  clampGridCam(); drawGrid();
},{passive:false});

el('gridZoomIn').onclick=()=>{ gridCam.zoom=Math.min(GRID_MAX_ZOOM,gridCam.zoom*1.25); clampGridCam(); drawGrid(); };
el('gridZoomOut').onclick=()=>{ gridCam.zoom=Math.max(GRID_MIN_ZOOM,gridCam.zoom/1.25); clampGridCam(); drawGrid(); };
el('gridZoomReset').onclick=()=>{ gridCam.inited=false; gridCam.x=COLS/2; gridCam.y=ROWS/2; drawGrid(); };

function drawGrid(){
  recomputeSeparatorAutosize();
  const {w:CW,h:CH}=fitCanvasToDisplay(gridCanvas,gctx);
  if(!gridCam.inited){
    const fitZoom=Math.min((CW*0.82)/(COLS*BASE_CELL),(CH*0.82)/(ROWS*BASE_CELL));
    gridCam.zoom=Math.max(GRID_MIN_ZOOM,Math.min(GRID_MAX_ZOOM,fitZoom));
    gridCam.inited=true;
  }
  const {cellPx,ox,oy}=gridOrigin(CW,CH);
  gctx.fillStyle='#141414'; gctx.fillRect(0,0,CW,CH);
  const gx0=Math.max(0,ox), gx1=Math.min(CW,ox+COLS*cellPx);
  const gy0=Math.max(0,oy), gy1=Math.min(CH,oy+ROWS*cellPx);
  gctx.strokeStyle='rgba(255,255,255,0.06)'; gctx.lineWidth=1;
  for(let c=0;c<=COLS;c++){
    const sx=ox+c*cellPx; if(sx<-2||sx>CW+2) continue;
    gctx.beginPath(); gctx.moveTo(sx+0.5,gy0); gctx.lineTo(sx+0.5,gy1); gctx.stroke();
  }
  for(let r=0;r<=ROWS;r++){
    const sy=oy+r*cellPx; if(sy<-2||sy>CH+2) continue;
    gctx.beginPath(); gctx.moveTo(gx0,sy+0.5); gctx.lineTo(gx1,sy+0.5); gctx.stroke();
  }
  gctx.strokeStyle='rgba(255,255,255,0.22)'; gctx.lineWidth=1;
  gctx.strokeRect(ox+0.5,oy+0.5,COLS*cellPx-1,ROWS*cellPx-1);
  gctx.strokeStyle='rgba(255,69,0,0.4)'; gctx.setLineDash([5,5]);
  const midX=ox+(COLS/2)*cellPx;
  gctx.beginPath(); gctx.moveTo(midX,oy); gctx.lineTo(midX,oy+ROWS*cellPx); gctx.stroke();
  gctx.setLineDash([]);
  placedParts.forEach(pp=>{
    const d=PARTS[pp.id];
    const rot=partRot(pp);
    const eff=effDims(pp.id,rot);
    const x=ox+pp.col*cellPx, y=oy+pp.row*cellPx;
    const ew=eff.w*cellPx, eh=eff.h*cellPx;
    const pad=cellPx*0.045;
    const nw=d.w*cellPx-pad*2, nh=d.h*cellPx-pad*2;
    drawPartShapeRotated(gctx,d,x+ew/2,y+eh/2,nw,nh,rot);
  });
  // Separator fairings — prefer fuel tanks above; if none, go to command pod
  if(modSettings.fairings) placedParts.forEach(pp=>{
    if(PARTS[pp.id].type!=='separator') return;
    const fp=placedFootprint(pp);
    const above=[];
    placedParts.forEach(other=>{
      if(other.uid===pp.uid) return;
      const ofp=placedFootprint(other);
      if(ofp.row+ofp.h<=fp.row && ofp.col<fp.col+fp.w && ofp.col+ofp.w>fp.col){
        above.push({pp:other, ofp, type:PARTS[other.id].type});
      }
    });
    if(!above.length) return;
    const tanks=above.filter(a=>a.type==='tank');
    const pods=above.filter(a=>a.type==='pod');
    // target: lowest tank bottom above sep, else lowest pod bottom above sep
    let target=null;
    if(tanks.length){
      // lowest tank above sep (largest bottom edge)
      target=tanks.reduce((best,a)=> (a.ofp.row+a.ofp.h)>(best.ofp.row+best.ofp.h)?a:best);
    } else if(pods.length){
      target=pods.reduce((best,a)=> (a.ofp.row+a.ofp.h)>(best.ofp.row+best.ofp.h)?a:best);
    } else {
      target=above.reduce((best,a)=> a.ofp.row<best.ofp.row?a:best);
    }
    // Fairing tip = BOTTOM of the upper part; base = TOP of the separator
    const tipRow=target.ofp.row+target.ofp.h; // bottom edge of upper part (row index)
    const baseRow=fp.row; // top of separator
    // If they touch, still draw a short collar so the fairing is visible
    const tipY=oy+Math.min(tipRow, baseRow-0.15)*cellPx;
    const baseY=oy+baseRow*cellPx;
    if(tipY>=baseY) return;
    const tipW=target.ofp.w*cellPx;
    const tipX=ox+target.ofp.col*cellPx;
    const baseX=ox+fp.col*cellPx;
    const baseW=fp.w*cellPx;
    gctx.save();
    gctx.globalAlpha=0.34;
    gctx.fillStyle='#c8d0d8';
    gctx.beginPath();
    gctx.moveTo(baseX, baseY);
    gctx.lineTo(baseX+baseW, baseY);
    gctx.lineTo(tipX+tipW, tipY);
    gctx.lineTo(tipX, tipY);
    gctx.closePath();
    gctx.fill();
    gctx.globalAlpha=0.55;
    gctx.strokeStyle='#aab4be';
    gctx.lineWidth=1.2;
    gctx.stroke();
    gctx.globalAlpha=0.22;
    gctx.beginPath();
    gctx.moveTo(baseX+baseW*0.5, baseY);
    gctx.lineTo(tipX+tipW*0.5, tipY);
    gctx.stroke();
    gctx.restore();
  });
  if(hoverCell&&mode==='build'&&!panState){
    const d=PARTS[selectedPartId];
    const eff=effDims(selectedPartId,selectedRot);
    const c=Math.min(Math.max(hoverCell.col,0),COLS-eff.w), r=Math.min(Math.max(hoverCell.row,0),ROWS-eff.h);
    const ok=canPlace(selectedPartId,c,r,selectedRot);
    const x=ox+c*cellPx, y=oy+r*cellPx;
    const ew=eff.w*cellPx, eh=eff.h*cellPx;
    gctx.fillStyle=ok?'rgba(255,69,0,0.22)':'rgba(211,47,47,0.28)';
    gctx.fillRect(x,y,ew,eh);
    gctx.strokeStyle=ok?'#FF4500':'#D32F2F'; gctx.lineWidth=1.5;
    gctx.strokeRect(x+0.75,y+0.75,ew-1.5,eh-1.5);
    const pad=cellPx*0.045;
    const nw=d.w*cellPx-pad*2, nh=d.h*cellPx-pad*2;
    drawDirArrow(gctx,x+ew/2,y+eh/2,nw,nh,selectedRot);
  }
}
