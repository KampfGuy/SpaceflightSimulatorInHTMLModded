function activeShip(){ return activeShipIdx>=0&&ships[activeShipIdx]?ships[activeShipIdx]:null; }

function buildSprite(parts){
  let minC=Infinity,minR=Infinity,maxC=-Infinity,maxR=-Infinity;
  parts.forEach(pp=>{
    const eff=effDims(pp.id,partRot(pp));
    minC=Math.min(minC,pp.col); minR=Math.min(minR,pp.row);
    maxC=Math.max(maxC,pp.col+eff.w); maxR=Math.max(maxR,pp.row+eff.h);
  });
  const cellsW=maxC-minC, cellsH=maxR-minR;
  const cnv=document.createElement('canvas');
  cnv.width=Math.max(1,cellsW*SPRITE_RASTER_CELL);
  cnv.height=Math.max(1,cellsH*SPRITE_RASTER_CELL);
  const ctx=cnv.getContext('2d');
  ctx.imageSmoothingEnabled=true;
  if('imageSmoothingQuality' in ctx) ctx.imageSmoothingQuality='high';
  let comXc=0,comYc=0,totalM=0;
  parts.forEach(pp=>{
    const d=PARTS[pp.id];
    const rot=partRot(pp);
    const eff=effDims(pp.id,rot);
    const cx=(pp.col-minC+eff.w/2)*SPRITE_RASTER_CELL, cy=(pp.row-minR+eff.h/2)*SPRITE_RASTER_CELL;
    const pad=SPRITE_RASTER_CELL*0.06;
    const nw=d.w*SPRITE_RASTER_CELL-pad*2, nh=d.h*SPRITE_RASTER_CELL-pad*2;
    drawPartShapeRotated(ctx,d,cx,cy,nw,nh,rot);
    const m=d.dryMass+d.fuel;
    comXc+=(pp.col-minC+eff.w/2)*m; comYc+=(pp.row-minR+eff.h/2)*m; totalM+=m;
  });
  // Separator fairings on the flight sprite — tip at BOTTOM of upper part
  if(modSettings.fairings) parts.forEach(pp=>{
    if(PARTS[pp.id].type!=='separator') return;
    const fp=placedFootprint(pp);
    const above=[];
    parts.forEach(other=>{
      if(other.uid===pp.uid) return;
      const ofp=placedFootprint(other);
      if(ofp.row+ofp.h<=fp.row && ofp.col<fp.col+fp.w && ofp.col+ofp.w>fp.col){
        above.push({ofp, type:PARTS[other.id].type});
      }
    });
    if(!above.length) return;
    const tanks=above.filter(a=>a.type==='tank');
    const pods=above.filter(a=>a.type==='pod');
    let target=null;
    if(tanks.length) target=tanks.reduce((b,a)=>(a.ofp.row+a.ofp.h)>(b.ofp.row+b.ofp.h)?a:b);
    else if(pods.length) target=pods.reduce((b,a)=>(a.ofp.row+a.ofp.h)>(b.ofp.row+b.ofp.h)?a:b);
    else target=above.reduce((b,a)=>a.ofp.row<b.ofp.row?a:b);
    const tipRow=target.ofp.row+target.ofp.h;
    const baseRow=fp.row;
    const S=SPRITE_RASTER_CELL;
    const tipY=(Math.min(tipRow, baseRow-0.15)-minR)*S;
    const baseY=(baseRow-minR)*S;
    if(tipY>=baseY) return;
    const tipW=target.ofp.w*S;
    const tipX=(target.ofp.col-minC)*S;
    const baseX=(fp.col-minC)*S;
    const baseW=fp.w*S;
    ctx.save();
    ctx.globalAlpha=0.34;
    ctx.fillStyle='#c8d0d8';
    ctx.beginPath();
    ctx.moveTo(baseX, baseY); ctx.lineTo(baseX+baseW, baseY);
    ctx.lineTo(tipX+tipW, tipY); ctx.lineTo(tipX, tipY);
    ctx.closePath(); ctx.fill();
    ctx.globalAlpha=0.5; ctx.strokeStyle='#aab4be'; ctx.lineWidth=1.5; ctx.stroke();
    ctx.restore();
  });
  if(totalM>0){ comXc/=totalM; comYc/=totalM; } else { comXc=cellsW/2; comYc=cellsH/2; }
  return {canvas:cnv, cellsW, cellsH, comXc, comYc};
}
function shipFootOffset(ship){
  return (ship.sprite.cellsH-ship.sprite.comYc)*CELL_WORLD;
}
function recomputeShipFromParts(ship){
  const s=statsFromParts(ship.parts);
  ship.dryMass=s.dryMass; ship.fuelCap=s.fuel;
  ship.thrust=s.thrust; ship.fuelRate=s.fuelRate;
  ship.sprite=ship.parts.length?buildSprite(ship.parts):ship.sprite;
  // drop per part state anything jettisoned
  const keepUids=new Set(ship.parts.map(pp=>String(pp.uid)));
  Object.keys(ship.tankFuel).forEach(uid=>{ if(!keepUids.has(uid)) delete ship.tankFuel[uid]; });
  Object.keys(ship.engineEnabled).forEach(uid=>{ if(!keepUids.has(uid)) delete ship.engineEnabled[uid]; });
  ship.engineConnections=computeEngineConnections(ship.parts);
  ship.fuel=Object.values(ship.tankFuel).reduce((a,b)=>a+b,0);
  if(s.engines===0) ship.engineOn=false;
  if(s.chutes===0) ship.chuteDeployed=false;
}

function shipCollisionRadius(sh){
  return Math.max(sh.sprite.cellsW,sh.sprite.cellsH)*CELL_WORLD*0.5;
}
function hasDockPort(sh){
  return sh.parts.some(pp=>PARTS[pp.id].type==='dock');
}
// dock s rotation 0 90 180
function dockDir(dockPart){ return partRot(dockPart); }
// world space unit vector local direction
function worldDirFromLocal(shipAngle,localDeg){
  const rad=(shipAngle||0)+localDeg*Math.PI/180;
  return {x:Math.sin(rad), y:Math.cos(rad)};
}
// rotate grid point multiple 90 clockwise
function rotateGridPoint(col,row,pivotCol,pivotRow,deltaDeg){
  let dx=col-pivotCol, dy=row-pivotRow;
  const steps=(((deltaDeg%360)+360)%360)/90;
  for(let i=0;i<steps;i++){ const ndx=-dy, ndy=dx; dx=ndx; dy=ndy; }
  return {col:pivotCol+dx, row:pivotRow+dy};
}
// Merges ship b into ship a at their dock ports — opposite of activateSeparator
function mergeShips(a,dockA,b,dockB){
  const dirA=dockDir(dockA), dirB=dockDir(dockB);
  const fpA=placedFootprint(dockA);
  // rotate ship b's parts so dockB faces opposite dockA
  const delta=(((dirA+180)-dirB)%360+360)%360;
  const fpBraw=placedFootprint(dockB);
  const pivot={col:fpBraw.col+fpBraw.w/2, row:fpBraw.row+fpBraw.h/2};
  // re-derive dockB's rotated footprint so the offset below lines up
  const dockBNewRot=(dirB+delta)%360;
  const dockBEff=effDims(dockB.id,dockBNewRot);
  // dockB's center is unmoved by its own rotation, only w/h changes
  const dockBNewCol=Math.round(pivot.col-dockBEff.w/2);
  const dockBNewRow=Math.round(pivot.row-dockBEff.h/2);
  // slide b so its port sits flush against a's port
  let colOff=0, rowOff=0;
  switch(dirA){
    case 0:   colOff=fpA.col-dockBNewCol;              rowOff=fpA.row-(dockBNewRow+dockBEff.h); break; // b above a
    case 180: colOff=fpA.col-dockBNewCol;              rowOff=(fpA.row+fpA.h)-dockBNewRow;       break; // b below a
    case 90:  rowOff=fpA.row-dockBNewRow;              colOff=(fpA.col+fpA.w)-dockBNewCol;       break; // b right of a
    case 270: rowOff=fpA.row-dockBNewRow;              colOff=fpA.col-(dockBNewCol+dockBEff.w);  break; // b left of a
  }
  const mA=a.dryMass+a.fuel, mB=b.dryMass+b.fuel;
  b.parts.forEach(pp=>{
    const newUid=partUidCounter++;
    if(b.tankFuel[pp.uid]!==undefined) a.tankFuel[newUid]=b.tankFuel[pp.uid];
    if(b.engineEnabled[pp.uid]!==undefined) a.engineEnabled[newUid]=b.engineEnabled[pp.uid];
    const oldEff=effDims(pp.id,partRot(pp));
    const center={col:pp.col+oldEff.w/2, row:pp.row+oldEff.h/2};
    const rotCenter=rotateGridPoint(center.col,center.row,pivot.col,pivot.row,delta);
    const newRot=(partRot(pp)+delta)%360;
    const newEff=effDims(pp.id,newRot);
    const newCol=Math.round(rotCenter.col-newEff.w/2)+colOff;
    const newRow=Math.round(rotCenter.row-newEff.h/2)+rowOff;
    a.parts.push({id:pp.id,col:newCol,row:newRow,uid:newUid,rot:newRot});
  });
  a.vel.x=(a.vel.x*mA+b.vel.x*mB)/(mA+mB);
  a.vel.y=(a.vel.y*mA+b.vel.y*mB)/(mA+mB);
  a.pos.x=(a.pos.x*mA+b.pos.x*mB)/(mA+mB);
  a.pos.y=(a.pos.y*mA+b.pos.y*mB)/(mA+mB);
  a.name=a.name+' + '+b.name;
  recomputeShipFromParts(a);
  const bIdx=ships.indexOf(b);
  ships.splice(bIdx,1);
  if(activeShipIdx===bIdx) activeShipIdx=ships.indexOf(a);
  else if(activeShipIdx>bIdx) activeShipIdx--;
  shipListDirty=true;
  showToast(a.name+' docked.');
  updateEngineBtn(); updateChuteBtn(); renderStagingList(); renderFuelList();
  saveShips();
}
// Skipped above 1x warp to avoid an O(n^2) check every substep at high timewarp.
function handleShipCollisions(){
  if(warp>1) return;
  for(let i=0;i<ships.length;i++){
    const a=ships[i]; if(a.status!=='flying'||a._pendingRemoval) continue;
    for(let j=i+1;j<ships.length;j++){
      const b=ships[j]; if(b.status!=='flying'||b._pendingRemoval) continue;
      const dx=b.pos.x-a.pos.x, dy=b.pos.y-a.pos.y;
      const dist=Math.hypot(dx,dy)||0.0001;
      if(hasDockPort(a)&&hasDockPort(b)&&dist<DOCK_SNAP_RADIUS){
        const docksA=a.parts.filter(pp=>PARTS[pp.id].type==='dock');
        const docksB=b.parts.filter(pp=>PARTS[pp.id].type==='dock');
        const relN={x:dx/dist,y:dy/dist};
        let merged=false;
        outer:
        for(const dockA of docksA){
          for(const dockB of docksB){
            const wA=worldDirFromLocal(a.angle,dockDir(dockA));
            const wB=worldDirFromLocal(b.angle,dockDir(dockB));
            // ports must face each other opposite
            const facingDot=wA.x*wB.x+wA.y*wB.y;
            if(facingDot>-0.85) continue;
            // b must actually sit direction s
            const alignDot=relN.x*wA.x+relN.y*wA.y;
            if(alignDot<0.85) continue;
            mergeShips(a,dockA,b,dockB);
            merged=true;
            break outer;
          }
        }
        if(merged) return;
      }
      const minDist=shipCollisionRadius(a)+shipCollisionRadius(b);
      if(dist>=minDist) continue;
      const relSpeed=Math.hypot(a.vel.x-b.vel.x,a.vel.y-b.vel.y);
      if(relSpeed>SHIP_COLLIDE_SAFE_SPEED){
        destroyShip(a,a.name+' collided with '+b.name+' at '+relSpeed.toFixed(0)+' m/s.');
        destroyShip(b,b.name+' collided with '+a.name+' at '+relSpeed.toFixed(0)+' m/s.');
      } else {
        // gentle bump — push apart so they can't sit inside each other
        const nx=dx/dist, ny=dy/dist, overlap=minDist-dist;
        a.pos.x-=nx*overlap/2; a.pos.y-=ny*overlap/2;
        b.pos.x+=nx*overlap/2; b.pos.y+=ny*overlap/2;
      }
    }
  }
}

