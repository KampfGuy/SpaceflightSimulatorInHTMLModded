// physics clone for ballistic prediction; _isBeaconClone silences toasts/UI
function cloneShipForBeacon(ship){
  return {
    pos:{x:ship.pos.x, y:ship.pos.y},
    vel:{x:ship.vel.x, y:ship.vel.y},
    angle:ship.angle,
    dryMass:ship.dryMass,
    fuel:ship.fuel,
    fuelCap:ship.fuelCap,
    sprite:ship.sprite,   // needed by shipFootOffset inside integrate
    parts:ship.parts,
    engineConnections:ship.engineConnections,
    engineEnabled:{},
    tankFuel:{},
    engineOn:false,       // no thrust in prediction
    throttle:0,
    chuteDeployed:false,
    status:'flying',
    name:'beacon-clone',
    _inAtmo:ship._inAtmo||false,
    _domBody:ship._domBody||null,
    _pendingRemoval:false,
    _isBeaconClone:true,  // prevents destroyShip from firing toasts/UI calls
  };
}

// substep loop beacon prediction same adaptive
const MAX_BEACON_STEPS = 300;
function beaconStepSimSeconds(f, simSeconds, tStart){
  if(!isFinite(simSeconds) || simSeconds<=0) return 0;
  if(!isFinite(f.pos.x) || !isFinite(f.pos.y)) return 0;
  let remaining=simSeconds, t=tStart, steps=0;
  const highWarpFloor = simSeconds > 50 ? Math.min(simSeconds/200, 5) : SUBSTEP_DT_MIN;
  while(remaining>1e-6 && steps<MAX_BEACON_STEPS && f.status==='flying'){
    const dom=findDominantBody(f.pos,t);
    const maxDt=domSubstepCap(dom);
    const nearest=dom
      ?domSurfaceGap(dom)
      :Math.max(1,Math.hypot(f.pos.x-SUN_POS.x,f.pos.y-SUN_POS.y)-SUN_RADIUS);
    let relVx=f.vel.x, relVy=f.vel.y;
    if(dom){ const pv=planetVelocityAt(dom.p,t); relVx-=pv.x; relVy-=pv.y; }
    const speed=Math.max(1,Math.hypot(relVx,relVy));
    let capDt=Math.min(maxDt,(nearest/speed)*SUBSTEP_NEAREST_FRACTION);
    if(!isFinite(capDt) || capDt<=0) capDt=maxDt;
    const dt=Math.min(remaining, Math.max(capDt, highWarpFloor));
    if(!isFinite(dt) || dt<=0) break;
    integrate(f,dt,t);
    if(!isFinite(f.pos.x) || !isFinite(f.pos.y)) break;
    t+=dt; remaining-=dt; steps++;
  }
  return t-tStart; // actual sim-seconds advanced (may be < simSeconds)
}

// simulate 15 real life seconds ballistic
function tagBeaconPoint(x,y,t){
  const dom=findDominantBody({x,y},t);
  if(!dom) return {x,y};
  return {x,y,body:dom.p,relX:x-dom.ppos.x,relY:y-dom.ppos.y};
}
function computeNavBeaconPath(ship, simT, currentWarp){
  const POINTS = 40;
  // 15 real secs × warp, capped so prediction never freezes the frame
  const totalSimSecs = Math.min(15 * currentWarp, 2e6);
  const segSimSecs   = totalSimSecs / POINTS;

  const clone=cloneShipForBeacon(ship);
  const path=[tagBeaconPoint(clone.pos.x, clone.pos.y, simT)];
  let t=simT;

  for(let i=0;i<POINTS;i++){
    // advance sim time actually simulated chunk
    const advanced=beaconStepSimSeconds(clone, segSimSecs, t);
    t+=advanced;
    path.push(tagBeaconPoint(clone.pos.x, clone.pos.y, t));
    if(clone.status!=='flying') break;
    // chunk came back significantly short step
    if(advanced<segSimSecs*0.999) break;
  }
  return path;
}

// physics based intercept solver simulates forward
function simulateForIntercept(baseShip, dvx, dvy, totalSimSecs, simT){
  const clone=cloneShipForBeacon(baseShip);
  clone.vel.x+=dvx; clone.vel.y+=dvy;
  // Fixed step count; step size self-limits to SUBSTEP_DT_MAX caps via beaconStep
  const STEPS=60;
  const segSecs=totalSimSecs/STEPS;
  let t=simT;
  for(let i=0;i<STEPS;i++){
    if(clone.status!=='flying') break;
    const advanced=beaconStepSimSeconds(clone, segSecs, t);
    t+=advanced;
  }
  return {x:clone.pos.x, y:clone.pos.y, crashed:clone.status!=='flying'};
}

// find best intercept delta v reach
const DEPARTURE_OFFSETS=[
  0, 300, 900, 1800, 3600, 7200, 14400, 21600,
  43200, 86400, 172800, 345600, 604800, 1209600, 2592000,
];
const TRANSFER_CANDIDATES=[
  3600, 10800, 21600, 43200,
  86400, 259200, 604800,
  1296000, 3456000, 8640000,
];
function findBestInterceptWindow(ship, planet, simT){
  const clone=cloneShipForBeacon(ship);
  let t=simT;
  let best=null;

  for(const offset of DEPARTURE_OFFSETS){
    // coast the clone (no thrust) to this candidate departure time
    const targetT=simT+offset;
    if(targetT>t){
      const need=targetT-t;
      const advanced=beaconStepSimSeconds(clone, need, t);
      t+=advanced;
      // hit something coasting — later departure times would already be moot
      if(clone.status!=='flying') break;
      // step budget fell short — later offsets only less reliable, stop here
      if(advanced<need*0.999) break;
    }

    for(const T of TRANSFER_CANDIDATES){
      const pFuture=planetPositionAt(planet, t+T);
      let dvx=(pFuture.x-clone.pos.x)/T - clone.vel.x;
      let dvy=(pFuture.y-clone.pos.y)/T - clone.vel.y;

      for(let iter=0; iter<5; iter++){
        const result=simulateForIntercept(clone, dvx, dvy, T, t);
        if(result.crashed) break;
        dvx+=(pFuture.x-result.x)/T;
        dvy+=(pFuture.y-result.y)/T;
      }

      const mag=Math.hypot(dvx,dvy);
      if(isFinite(mag) && (!best||mag<best.mag)){
        best={
          dvx, dvy, mag, interceptT:T,
          burnSimTime:t,             // WHEN (sim-time) to execute this burn
          waitSecs:t-simT,           // how long from now that is
          burnPos:{x:clone.pos.x,y:clone.pos.y}, // WHERE the ship will be then
        };
      }
    }
  }
  return best;
}

// force onto plan at very high
function computeNavPlanCoastPath(ship, simT, burnSimTime){
  const POINTS=60;
  const totalSimSecs=Math.max(0,burnSimTime-simT);
  const path=[{t:simT,x:ship.pos.x,y:ship.pos.y,vx:ship.vel.x,vy:ship.vel.y}];
  if(totalSimSecs<=0) return path;
  const segSimSecs=totalSimSecs/POINTS;
  const clone=cloneShipForBeacon(ship);
  let t=simT;
  for(let i=0;i<POINTS;i++){
    const advanced=beaconStepSimSeconds(clone, segSimSecs, t);
    t+=advanced;
    path.push({t, x:clone.pos.x, y:clone.pos.y, vx:clone.vel.x, vy:clone.vel.y});
    if(clone.status!=='flying') break;
    // step budget fell short — later samples only less accurate, stop here
    if(advanced<segSimSecs*0.999) break;
  }
  return path;
}

// sample frozen coast path at time t, clamped to its ends
function sampleNavPlanCoastPath(path, t){
  if(!path||path.length===0) return null;
  if(t<=path[0].t) return path[0];
  const last=path[path.length-1];
  if(t>=last.t) return last;
  for(let i=0;i<path.length-1;i++){
    const a=path[i], b=path[i+1];
    if(t>=a.t&&t<=b.t){
      const span=b.t-a.t;
      const f=span>1e-9?(t-a.t)/span:0;
      return {
        x:a.x+(b.x-a.x)*f, y:a.y+(b.y-a.y)*f,
        vx:a.vx+(b.vx-a.vx)*f, vy:a.vy+(b.vy-a.vy)*f,
      };
    }
  }
  return last;
}

// guaranteed intercept post burn coast path
function computeNavPostBurnCoastPath(ship, simT, arrivalT, planet){
  const rawPath=computeNavPlanCoastPath(ship, simT, arrivalT);
  if(rawPath.length<2) return rawPath;

  const rawFinal=rawPath[rawPath.length-1];
  // use raw path s own final
  const actualArrival=rawFinal.t;
  const targetPos=planetPositionAt(planet, actualArrival);
  const missX=targetPos.x-rawFinal.x;
  const missY=targetPos.y-rawFinal.y;
  const missMag=Math.hypot(missX,missY);
  // already close enough common case well
  const NO_CORRECTION_NEEDED=50;
  if(missMag<NO_CORRECTION_NEEDED) return rawPath;

  const startT=rawPath[0].t;
  const span=Math.max(1e-6, actualArrival-startT);
  const corrected=rawPath.map(p=>{
    const frac=Math.min(1,Math.max(0,(p.t-startT)/span));
    const ease=frac*frac*(3-2*frac); // smoothstep: 0 at start, 1 at end, zero slope at both ends
    return {t:p.t, x:p.x+missX*ease, y:p.y+missY*ease, vx:p.vx, vy:p.vy};
  });
  // re derive velocity from corrected positions
  for(let i=0;i<corrected.length;i++){
    const prev=corrected[Math.max(0,i-1)];
    const next=corrected[Math.min(corrected.length-1,i+1)];
    const dt=next.t-prev.t;
    if(dt>1e-6){
      corrected[i].vx=(next.x-prev.x)/dt;
      corrected[i].vy=(next.y-prev.y)/dt;
    }
  }
  return corrected;
}

// returns whichever frozen coast path currently
function activeNavForcedPath(atTime){
  if(!cheats.navBeacon||!navDeltaV) return null;
  const sh=activeShip();
  if(!sh||sh.status!=='flying') return null;
  const t=atTime===undefined?simTime:atTime;
  if(navPlanCoastPath.length&&t<navDeltaV.burnSimTime){
    return navPlanCoastPath;
  }
  if(navBurnDone&&navPostBurnCoastPath.length&&t<navDeltaV.burnSimTime+navDeltaV.interceptT){
    return navPostBurnCoastPath;
  }
  return null;
}

