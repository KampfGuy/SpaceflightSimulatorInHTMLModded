// ---- Atmosphere heating (reentry only — ascent / low speed does not cook you) ----
function applyAeroHeating(f,dt){
  if(!modSettings.heat||f.status!=='flying'||!f._inAtmo||!f._domBody) return;
  const p=f._domBody;
  if(!p.solid){ // gas giant — crush deep in
    const dens=getAtmoDensity(f.pos,p);
    if(dens>0.55){ destroyShip(f,f.name+' was crushed & cooked in '+p.name); return; }
  }
  const dens=getAtmoDensity(f.pos,p);
  if(dens<=0){
    // cool off in vacuum
    f.heatAcc=Math.max(0,(f.heatAcc||0)-0.4*dt);
    return;
  }
  const ppos=planetPositionAt(p,simTime);
  const pv=planetVelocityAt(p,simTime);
  const rel=Math.hypot(f.vel.x-pv.x,f.vel.y-pv.y);
  // Local circular speed — only heat when significantly faster than launch profile
  const r=Math.hypot(f.pos.x-ppos.x,f.pos.y-ppos.y)||1;
  const vCirc=Math.sqrt((p.GM||1)/r);
  // Ascent speeds stay below ~0.7*vCirc in dense air; reentry is near/above circular
  if(rel < vCirc*0.75){
    f.heatAcc=Math.max(0,(f.heatAcc||0)-0.5*dt); // radiate while slow
    return;
  }
  // heating ~ density * ((v - threshold)/scale)^3
  const excess=Math.max(0, rel - vCirc*0.75);
  const heat=dens*Math.pow(excess/(vCirc*0.5+1), 3);
  f.heatAcc=(f.heatAcc||0)+heat*dt;
  const hasShield=f.parts.some(pp=>PARTS[pp.id]&&PARTS[pp.id].type==='heatshield');
  const limit=hasShield?18:8;
  if(f.heatAcc>limit){
    destroyShip(f, hasShield
      ? f.name+' heat shield failed on reentry into '+p.name
      : f.name+' burned up on reentry into '+p.name+' (no heat shield)');
  }
}

// ---- Water / surface fluids ----
function bodyHasSurfaceFluid(p){
  if(!p) return null;
  if(p.key==='earth') return 'water';
  if(p.key==='titan') return 'methane';
  if(p.key==='europa'||p.key==='enceladus'||p.key==='ganymede') return 'icewater'; // under ice
  return null;
}
function isOverFluid(f){
  if(!f._domBody) return false;
  const fluid=bodyHasSurfaceFluid(f._domBody);
  if(!fluid) return false;
  // near surface
  const ppos=planetPositionAt(f._domBody,simTime);
  const alt=Math.hypot(f.pos.x-ppos.x,f.pos.y-ppos.y)-f._domBody.radius;
  if(fluid==='icewater') return alt< -5; // only after drilling below
  return alt<8 && alt>-20;
}

// ---- Drill ----
function tryDrill(f,dt){
  if(!f||f.status!=='landed') return;
  if(!f.parts.some(pp=>PARTS[pp.id]&&PARTS[pp.id].type==='drill')) return;
  if(!(keys['d']||keys['arrowdown'])) return;
  f.drillDepth=(f.drillDepth||0)+18*dt; // meters
  if(f.drillDepth>40){
    const fluid=bodyHasSurfaceFluid(f.landedOnPlanet||f._domBody);
    if(fluid==='icewater'&&!f._hitSubsurfaceWater){
      f._hitSubsurfaceWater=true;
      showToast('Drill struck subsurface water!');
      if(activeWorld&&activeWorld.mode==='campaign'){ activeWorld.money+=8000; showToast('+$8,000 contract: subsurface water sample'); }
    }
  }
}

