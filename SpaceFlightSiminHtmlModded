  {key:'miranda',name:'Miranda',parent:'uranus',color:'#b8c0c0',groundColor:'#98a0a0',radiusMod:0.00923,distMod:5.10, surfG:0.079,eccMod:0.99870,solid:true,atmo:false},
  {key:'ariel',  name:'Ariel',  parent:'uranus',color:'#c8d0d0',groundColor:'#a8b0b0',radiusMod:0.02265,distMod:7.53, surfG:0.269,eccMod:0.99880,solid:true,atmo:false},
  {key:'umbriel',name:'Umbriel',parent:'uranus',color:'#787c7c',groundColor:'#5c6060',radiusMod:0.02288,distMod:10.49,surfG:0.253,eccMod:0.99610,solid:true,atmo:false},
  {key:'titania',name:'Titania',parent:'uranus',color:'#9098a0',groundColor:'#707880',radiusMod:0.03085,distMod:17.20,surfG:0.379,eccMod:0.99890,solid:true,atmo:false},
  {key:'oberon', name:'Oberon', parent:'uranus',color:'#888078',groundColor:'#68605a',radiusMod:0.02979,distMod:23.01,surfG:0.347,eccMod:0.99860,solid:true,atmo:false},

  {key:'triton', name:'Triton', parent:'neptune',color:'#e8c8d8',groundColor:'#c8a8b8',radiusMod:0.05465,distMod:14.41, surfG:0.779,eccMod:0.99998,solid:true,atmo:false},
  {key:'nereid', name:'Nereid', parent:'neptune',color:'#9098a8',groundColor:'#707888',radiusMod:0.00697,distMod:223.9, surfG:0.071,eccMod:0.25100,solid:true,atmo:false},

  {key:'charon',  name:'Charon',  parent:'pluto',color:'#a8a8a8',groundColor:'#888888',radiusMod:0.50997,distMod:16.49,surfG:0.288,eccMod:0.99995,solid:true,atmo:false},
  {key:'styx',    name:'Styx',    parent:'pluto',color:'#9c9c9c',groundColor:'#7c7c7c',radiusMod:0.00421,distMod:35.9, surfG:0.001,eccMod:0.99420,solid:true,atmo:false},
  {key:'nix',     name:'Nix',     parent:'pluto',color:'#a4a4a4',groundColor:'#848484',radiusMod:0.02104,distMod:40.99,surfG:0.003,eccMod:0.99800,solid:true,atmo:false},
  {key:'kerberos',name:'Kerberos',parent:'pluto',color:'#909090',groundColor:'#707070',radiusMod:0.00799,distMod:48.64,surfG:0.003,eccMod:0.99670,solid:true,atmo:false},
  {key:'hydra',   name:'Hydra',   parent:'pluto',color:'#989898',groundColor:'#787878',radiusMod:0.02314,distMod:54.5, surfG:0.003,eccMod:0.99410,solid:true,atmo:false},
];

//Sun is root and has no parent. so i made it null. 
const SUN_BODY = {key:'sun',name:'Sun',parent:null,radius:SUN_RADIUS,color:'#ffb020',GM:GM_SUN,GMbase:GM_SUN,solid:false,atmo:false};
const BODIES_BY_KEY = {sun:SUN_BODY};

function eccFromMod(mod){
  return Math.min(0.995,Math.max(0,1-(mod===undefined?1:mod)));
}
function solveKepler(M,e){
  let E=M;
  for(let i=0;i<8;i++){
    E-=(E-e*Math.sin(E)-M)/(1-e*Math.cos(E));
  }
  return E;
}

const TOP_LEVEL_PLANETS = PLANET_DEFS.map((p,i)=>{
  const distance = p.distAU*AU;
  const GM = p.surfG*p.radius*p.radius*PLANET_GM_MULT;
  // GMbase excludes PLANET_GM_MULT — keeps SOI size stable regardless of boosted gravity
  const GMbase = p.surfG*p.radius*p.radius;
  // Divide by sqrt(ORBIT_PERIOD_CALIBRATION_MULT) — artificial pacing, independent of GM_SUN_MULT
  const periodSimSeconds = (p.periodDays/365.25)*ORBIT_YEAR_SECONDS/Math.sqrt(ORBIT_PERIOD_CALIBRATION_MULT);
  const omega = 2*Math.PI/periodSimSeconds;
  const initialAngle = (i/PLANET_DEFS.length)*Math.PI*2;
  const soi = Math.max(p.radius*3, distance*Math.cbrt(GMbase/(3*GM_SUN))*SOI_SCALE);
  const ecc = eccFromMod(p.eccMod);
  const body = Object.assign({},p,{distance,GM,GMbase,omega,initialAngle,soi,ecc});
  BODIES_BY_KEY[body.key]=body;
  return body;
});

//Moon math is anchored to planet like how planets anchor to sun
const MOONS = MOON_DEFS.map(m=>{
  const parent=BODIES_BY_KEY[m.parent];
  const radius = m.radiusMod*parent.radius;
  const distance = m.distMod*parent.radius;
  const GMbase = m.surfG*radius*radius;
  const GM = GMbase*PLANET_GM_MULT;
  const omega = Math.sqrt(parent.GM/(distance*distance*distance));
  const initialAngle = (moonAngleSeed++%7)/7*Math.PI*2;
  const soi = Math.max(radius*3, distance*Math.cbrt(GMbase/(3*parent.GM))*SOI_SCALE)*MOON_SOI_MULT; //this computes moon soi multi from earlier which i set
  const ecc = eccFromMod(m.eccMod);
  const body = Object.assign({},m,{radius,distance,GM,GMbase,omega,initialAngle,soi,ecc});
  BODIES_BY_KEY[body.key]=body;
  return body;
});

//i made sun SOI not infinity so i can add Alpha Centauri later.
SUN_BODY.soi = 3.5*BODIES_BY_KEY['pluto'].distance;

//planets now got moons so update this
const PLANETS = [...TOP_LEVEL_PLANETS, ...MOONS];
// STAR_BODIES is its own array so Alpha Centauri can be appended later without touching downstream code
const STAR_BODIES = [SUN_BODY];
//everybody includes the sun though.
const ALL_BODIES = [...STAR_BODIES, ...PLANETS];

// SOI nesting depth (sun=0, planet=1, moon=2) — gates timewarp caps and auto-pause
function bodyDepth(b){ // warp cap based on soi type if planet or moon or sun or whatever
  let d=0, cur=b;
  while(cur&&cur.parent){ d++; cur=BODIES_BY_KEY[cur.parent]; }
  return d;
}

function planetOrbitState(p,t){
  const e=p.ecc;
  const M=p.initialAngle+p.omega*t;
  if(e<=0.0001){
    return {r:p.distance, theta:M, drdt:0, dthetadt:p.omega};
  }
  const E=solveKepler(M,e);
  const cosE=Math.cos(E), sinE=Math.sin(E);
  const r=p.distance*(1-e*cosE);
  const theta=2*Math.atan2(Math.sqrt(1+e)*Math.sin(E/2),Math.sqrt(1-e)*Math.cos(E/2));
  const dEdt=p.omega/(1-e*cosE);
  const drdt=p.distance*e*sinE*dEdt;
  const dthetadt=Math.sqrt(1-e*e)*p.omega/((1-e*cosE)*(1-e*cosE));
  return {r,theta,drdt,dthetadt};
}

//Basically if theres a binary star (Like Alpha Centauri!!) later on, this will handle it so i dont have to deal with this math later. I'll also not have to worry about it crashing.
function binaryAnchorPos(defining,t){
  const anchorKey=defining.barycenterParent||null;
  return anchorKey?planetPositionAt(BODIES_BY_KEY[anchorKey],t):SUN_POS;
}
function binaryAnchorVel(defining,t){
  const anchorKey=defining.barycenterParent||null;
  return anchorKey?planetVelocityAt(BODIES_BY_KEY[anchorKey],t):{x:0,y:0};
}
function binaryPairPosition(p,partner,t){
  const defining=p.binaryMirror?partner:p;
  const o=planetOrbitState(defining,t);
  const sepX=o.r*Math.cos(o.theta), sepY=o.r*Math.sin(o.theta);
  const anchor=binaryAnchorPos(defining,t);
  const totalR=p.radius+partner.radius;
  const frac=(defining===p)?(partner.radius/totalR):(-p.radius/totalR);
  return {x:anchor.x+sepX*frac, y:anchor.y+sepY*frac};
}
function binaryPairVelocity(p,partner,t){
  const defining=p.binaryMirror?partner:p;
  const o=planetOrbitState(defining,t);
  const cosT=Math.cos(o.theta), sinT=Math.sin(o.theta);
  const svx=o.drdt*cosT-o.r*o.dthetadt*sinT, svy=o.drdt*sinT+o.r*o.dthetadt*cosT;
  const anchorV=binaryAnchorVel(defining,t);
  const totalR=p.radius+partner.radius;
  const frac=(defining===p)?(partner.radius/totalR):(-p.radius/totalR);
  return {x:anchorV.x+svx*frac, y:anchorV.y+svy*frac};
}

function planetPositionAt(p,simTime){
  if(p.parent===null) return SUN_POS; //Sun doesnt orbit anything and it doesnt have a parent as stated earlier
  const parent=BODIES_BY_KEY[p.parent];
  if(parent.parent===p.key) return binaryPairPosition(p,parent,simTime);
  const parentPos=planetPositionAt(parent,simTime);
  const o=planetOrbitState(p,simTime);
  return {x:parentPos.x+o.r*Math.cos(o.theta), y:parentPos.y+o.r*Math.sin(o.theta)};
}
function planetVelocityAt(p,t){
  if(p.parent===null) return {x:0,y:0};
  const parent=BODIES_BY_KEY[p.parent];
  if(parent.parent===p.key) return binaryPairVelocity(p,parent,t);
  const o=planetOrbitState(p,t);
  const cosT=Math.cos(o.theta), sinT=Math.sin(o.theta);
  const localV={x:o.drdt*cosT-o.r*o.dthetadt*sinT, y:o.drdt*sinT+o.r*o.dthetadt*cosT};
  const parentV=planetVelocityAt(parent,t);
  return {x:parentV.x+localV.x, y:parentV.y+localV.y};
}

//The smallest soi you are in is the one that effects you and all others get dropped or should get dropped - edit yes this works as intended
function findDominantBody(pos,t){
  let best=null;
  for(const p of ALL_BODIES){
    const ppos=planetPositionAt(p,t);
    const d=Math.hypot(pos.x-ppos.x,pos.y-ppos.y);
    if(d<=p.soi&&(!best||p.soi<best.p.soi)){ best={p,ppos,dist:d}; }
  }
  return best;
}

