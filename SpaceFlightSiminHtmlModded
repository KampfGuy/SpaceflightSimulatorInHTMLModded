// ship flight trail capped at trail
const TRAIL_MAX=3000;
function makeTrail(){
  return {
    buf:new Array(TRAIL_MAX), start:0, count:0,
    push(p){
      this.buf[(this.start+this.count)%TRAIL_MAX]=p;
      if(this.count<TRAIL_MAX) this.count++;
      else this.start=(this.start+1)%TRAIL_MAX;
    },
    get length(){ return this.count; },
    forEach(fn){
      for(let i=0;i<this.count;i++) fn(this.buf[(this.start+i)%TRAIL_MAX], i);
    },
  };
}
function pushTrail(f){
  const p={x:f.pos.x, y:f.pos.y};
  if(!f.lastTrailPos||Math.hypot(p.x-f.lastTrailPos.x,p.y-f.lastTrailPos.y)>EARTH.radius*0.02){
    // close planet point stored relative planet
    if(f._domBody){
      const bpos=planetPositionAt(f._domBody,simTime);
      p.body=f._domBody; p.relX=p.x-bpos.x; p.relY=p.y-bpos.y;
    }
    f.trail.push(p);
    f.lastTrailPos=p;
  }
}
// re-anchors a stored trail point to its planet's current position
function trailPointWorldPos(p){
  if(!p.body) return p;
  const bpos=planetPositionAt(p.body,simTime);
  return {x:bpos.x+p.relX, y:bpos.y+p.relY};
}

