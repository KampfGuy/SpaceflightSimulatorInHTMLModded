    b.classList.toggle('active',parseFloat(b.dataset.w)===w);
  });
  hud.warp.textContent=formatWarpLabel(w);
}
function computeMaxAllowedWarp(){
  let cap=Infinity; //no cap frfr
  ships.forEach(s=>{
    if(s.status==='landed') return; // landed ships don't restrict warp
    if(s.status!=='flying') return;
    if(s._inAtmo){ cap=Math.min(cap,5); return; } // allow up to 5× warp inside atmospheres
    const depth=bodyDepth(s._domBody); //cap based on planet moon or sun or interstellar or wtv
    if(depth>=2) cap=Math.min(cap,100); //100x cap inside moon soi
    else if(depth===1) cap=Math.min(cap,10000); //and 10kx for planet soi.
  });
  return cap;
}
function largestAllowedLevel(maxAllowed){
  let best=0;
  WARP_LEVELS.forEach(w=>{ if(w<=maxAllowed) best=w; });
  return best;
}
function updateWarpButtonsUI(maxAllowed, minAllowed){
  minAllowed=minAllowed===undefined?0:minAllowed; //defaults to 0
  document.querySelectorAll('.warp-btn').forEach(b=>{
    const w=parseFloat(b.dataset.w);
    const disabled=w>maxAllowed||w<minAllowed;
