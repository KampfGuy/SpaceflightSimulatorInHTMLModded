  {key:'io',      name:'Io',      parent:'jupiter',color:'#e8d24a',groundColor:'#c9a530',radiusMod:0.02548,distMod:6.03,  surfG:1.80,  eccMod:0.99590,solid:true,atmo:false},
  {key:'europa',  name:'Europa',  parent:'jupiter',color:'#d8c9a8',groundColor:'#b8a888',radiusMod:0.02183,distMod:9.60,  surfG:1.31,  eccMod:0.99100,solid:true,atmo:false},
