  const twr=s.wetMass>0?(s.thrust/(s.wetMass*EARTH_SURF_G)):0;
  const ve=s.fuelRate>0?s.thrust/s.fuelRate:0;
  const dv=(ve>0&&s.dryMass>0)?ve*Math.log(s.wetMass/s.dryMass):0;
  return Object.assign({},s,{twr,dv});
}
