  // Sample atmosphere at the camera (free-cam) or the ship
  const samplePos=(!camFree&&activeSh)?activeSh.pos:{x:camera.x,y:camera.y};
  let dens=0, atmoCol=null;
  for(const p of PLANETS){
    if(!p.atmo||!p.atmoColor) continue;
    const d=getAtmoDensity(samplePos,p);
    if(d>dens){ dens=d; atmoCol=p.atmoColor; }
  }
  // Zoom force-to-space: once each pixel is large enough, sky becomes space
  // (so scrolling out from Earth always reveals the starfield)
  const SPACE_MPP=60;          // full space by this zoom
