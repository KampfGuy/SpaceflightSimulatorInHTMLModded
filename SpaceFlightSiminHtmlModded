    navPlanCoastPath=[]; navBurnDone=false; navPostBurnCoastPath=[];
    el('navArrowPanel').style.display='none';
  }

  // nav beacon detect missed intercept clear
  if(cheats.navBeacon&&navBurnDone&&navDeltaV&&sh&&sh.status==='flying'
     &&simTime>=navDeltaV.burnSimTime+navDeltaV.interceptT){
    showToast('Nav Beacon: intercept with '+(navTargetPlanet?navTargetPlanet.name:'target')+' missed — plan cleared.');
    navTargetPlanet=null; navDeltaV=null; navBurnWarpDropped=false; navBurnTargetVel=null;
    navPlanCoastPath=[]; navBurnDone=false; navPostBurnCoastPath=[];
    el('navArrowPanel').style.display='none';
  }

  // nav beacon 15s ballistic preview recomputed
  if(cheats.navBeacon){
    const nsh=activeShip();
    if(nsh&&nsh.status==='flying'){
      const beaconThrottle=warp>1000?Math.min(20,Math.ceil(warp/1000)):1;
      if(frameCount%beaconThrottle===0) navBeaconPath=computeNavBeaconPath(nsh,simTime,warp);
    } else {
      navBeaconPath=[];
      if(!nsh){
        navTargetPlanet=null; navDeltaV=null; navBurnTargetVel=null; navPlanCoastPath=[]; navBurnDone=false; navPostBurnCoastPath=[];
        el('navArrowPanel').style.display='none';
      }
    }
  } else {
    if(el('navArrowPanel').style.display!=='none') el('navArrowPanel').style.display='none';
  }

  frameCount++;
  if(frameCount%60===0) saveShips();

  if(el('flightScreen').classList.contains('active')){
    render();
    if(shipListDirty){ renderShipList(); shipListDirty=false; }
    renderFuelList();
  }
  requestAnimationFrame(loop);
}
