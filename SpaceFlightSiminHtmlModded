    fctx.fillRect(-sc*0.4, sc*0.75, sc*0.35, sc*0.18);
    fctx.fillRect( sc*0.05, sc*0.75, sc*0.35, sc*0.18);
    // body / suit
    const suit=fctx.createLinearGradient(-sc*0.5,-sc*0.5,sc*0.5,sc*0.4);
    suit.addColorStop(0,'#f2f5fa'); suit.addColorStop(0.5,'#d0d6e0'); suit.addColorStop(1,'#a8b0bc');
    fctx.fillStyle=suit;
    fctx.fillRect(-sc*0.45, -sc*0.35, sc*0.9, sc*0.6);
    // backpack
    fctx.fillStyle='#6a7380';
    fctx.fillRect(-sc*0.55, -sc*0.25, sc*0.22, sc*0.45);
    // arms
    fctx.fillStyle='#d8dde4';
    fctx.fillRect(-sc*0.7, -sc*0.2, sc*0.28, sc*0.22);
    fctx.fillRect( sc*0.42, -sc*0.2, sc*0.28, sc*0.22);
    // helmet
    const hel=fctx.createRadialGradient(-sc*0.1,-sc*0.7,1,0,-sc*0.55,sc*0.4);
