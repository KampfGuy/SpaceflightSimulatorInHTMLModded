    ctx.strokeRect(x+w*0.08,y+h*0.08,w*0.84,h*0.84);
    // radar mast
    ctx.fillStyle='rgba(200,200,210,0.7)';
    ctx.fillRect(x+w*0.45,y,w*0.1,h*0.12);
  }
  if(d.type==='prop'||d.type==='shipprop'){
    // spinner + blades
    ctx.fillStyle='rgba(30,30,30,0.8)';
    ctx.beginPath(); ctx.arc(x+w/2,y+h/2,Math.min(w,h)*0.15,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle='rgba(60,50,40,0.9)'; ctx.lineWidth=Math.max(2,w*0.08);
    ctx.beginPath(); ctx.moveTo(x+w*0.1,y+h*0.5); ctx.lineTo(x+w*0.9,y+h*0.5); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x+w*0.5,y+h*0.1); ctx.lineTo(x+w*0.5,y+h*0.9); ctx.stroke();
  }
  if(d.type==='gear'){
    ctx.fillStyle='rgba(40,40,40,0.85)';
    ctx.beginPath(); ctx.arc(x+w/2,y+h*0.65,Math.min(w,h)*0.28,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle='rgba(180,180,180,0.5)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.arc(x+w/2,y+h*0.65,Math.min(w,h)*0.28,0,Math.PI*2); ctx.stroke();
    ctx.fillStyle='rgba(120,120,120,0.7)'; ctx.fillRect(x+w*0.4,y+h*0.1,w*0.2,h*0.35);
  }

  ctx.restore();
}
// draws part rotated about own center
function drawPartShapeRotated(ctx,d,cx,cy,nw,nh,rot){
  ctx.save();
  ctx.translate(cx,cy);
  ctx.rotate((rot||0)*Math.PI/180);
  drawPartShape(ctx,d,-nw/2,-nh/2,nw,nh);
  ctx.restore();
}
// yellow direction arrow drawn pointing up
function drawDirArrow(ctx,cx,cy,nw,nh,rot){
  ctx.save();
  ctx.translate(cx,cy);
  ctx.rotate((rot||0)*Math.PI/180);
  const len=Math.min(nw,nh)*0.85, headW=len*0.36, shaftW=len*0.14;
  const tipY=-nh*0.42, baseY=tipY+len*0.62;
  ctx.fillStyle='#FFD500';
  ctx.strokeStyle='rgba(0,0,0,0.55)'; ctx.lineWidth=Math.max(1,len*0.05);
  ctx.beginPath();
  ctx.moveTo(0,tipY);
  ctx.lineTo(headW/2,baseY);
  ctx.lineTo(shaftW/2,baseY);
  ctx.lineTo(shaftW/2,baseY+len*0.38);
  ctx.lineTo(-shaftW/2,baseY+len*0.38);
  ctx.lineTo(-shaftW/2,baseY);
  ctx.lineTo(-headW/2,baseY);
  ctx.closePath();
  ctx.fill(); ctx.stroke();
  ctx.restore();
}

