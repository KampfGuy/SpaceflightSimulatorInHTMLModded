  PLANETS.forEach(p=>{ if(visibleBodies.has(p)) drawPlanet(p,simTime,{x:camera.x,y:camera.y}); });
  PLANETS.forEach(p=>{ if(visibleBodies.has(p)) drawClouds(p,simTime); });
