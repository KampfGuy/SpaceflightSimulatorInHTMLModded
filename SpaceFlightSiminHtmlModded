  if(sh.status==='landed'){
    b.textContent='LAUNCH ▲';
    b.classList.remove('on');
  } else {
    b.textContent='ENGINE: '+(sh.engineOn?'ON':'OFF');
    b.classList.toggle('on',sh.engineOn);
  }
}
function toggleEngine(){ //changed location of this so pressing space can toggle it
  const sh=activeShip();
  if(!sh) return;
  if(sh.status==='landed'){
    // Lift off — transition ship to flying with engine on
    sh.status='flying';
    sh.statusMsg='';
    sh.landedRelPos=null;
    sh.landedOnPlanet=null;
    sh._inAtmo=true; // still on surface, physics will sort it out
    sh.engineOn=true;
    if(warp>1) setWarp(1);
    updateEngineBtn(); updateChuteBtn(); renderStagingList(); renderFuelList();
    return;
  }
  if(sh.status!=='flying') return;
  if(warp>1) setWarp(1);
  sh.engineOn=!sh.engineOn; updateEngineBtn();
}
