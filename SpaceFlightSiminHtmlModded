function drawSun(){
  const s=worldToScreen(SUN_POS.x,SUN_POS.y);
  const r=Math.max(1.2,SUN_RADIUS/camera.metersPerPixel);
  const CW=flightCanvas.clientWidth, CH=flightCanvas.clientHeight;
  if(s.x<-r-5||s.x>CW+r+5||s.y<-r-5||s.y>CH+r+5) return;
  const grad=fctx.createRadialGradient(s.x-r*0.3,s.y-r*0.3,r*0.05,s.x,s.y,r);
  grad.addColorStop(0,shadeColor('#ffb020',0.3));
  grad.addColorStop(1,shadeColor('#ffb020',-0.15));
  fctx.beginPath(); fctx.arc(s.x,s.y,r,0,Math.PI*2); fctx.fillStyle=grad; fctx.fill();
  if(r>2){ fctx.lineWidth=1; fctx.strokeStyle='rgba(255,255,255,0.12)'; fctx.stroke(); }
  if(r>10){ fctx.fillStyle='rgba(255,255,255,0.75)'; fctx.font='11px sans-serif'; fctx.fillText('Sun',s.x+r+4,s.y+4); }
}

function drawOrbitPath(p,t){
  if(p.parent===null) return; //sun has no parent and no orbit, like explained previously
  const parent=BODIES_BY_KEY[p.parent];
  if(parent.parent===p.key) return; //This is extremely hard to explain. Basically more binary star math.
  const parentPos=planetPositionAt(parent,t);
  const e=p.ecc;
  const a=p.distance;
  const b=a*Math.sqrt(1-e*e);
  const cx=parentPos.x-a*e, cy=parentPos.y;
  const s=worldToScreen(cx,cy);
  const rx=a/camera.metersPerPixel, ry=b/camera.metersPerPixel;
  // Screen-size based cutoff instead of a fixed metersPerPixel threshold, so tiny moon orbit rails still draw when zoomed in close. this was an annoying bug
  const maxDim=Math.max(flightCanvas.clientWidth,flightCanvas.clientHeight);
  if(rx<ORBIT_MIN_PX&&ry<ORBIT_MIN_PX) return; //if too small it isnt worth drawing
  if(rx>maxDim*ORBIT_MAX_PX_MULT) return; //too big just a straight line across teh screen thats also not worth it
  fctx.beginPath(); fctx.ellipse(s.x,s.y,rx,ry,camera.angle,0,Math.PI*2);
  fctx.strokeStyle=hexToRgba(p.color,0.3); fctx.lineWidth=1; fctx.stroke();
}

function drawSOICircle(p,t){
  const pos=planetPositionAt(p,t);
  const s=worldToScreen(pos.x,pos.y);
  const r=p.soi/camera.metersPerPixel;
  if(r<3||r>Math.max(flightCanvas.clientWidth,flightCanvas.clientHeight)*6) return;
  fctx.beginPath(); fctx.arc(s.x,s.y,r,0,Math.PI*2);
  fctx.setLineDash([8,6]);
  fctx.strokeStyle=hexToRgba(p.color,0.35); fctx.lineWidth=1; fctx.stroke();
  fctx.setLineDash([]);
  if(r>60){ fctx.fillStyle=hexToRgba(p.color,0.7); fctx.font='10px sans-serif'; fctx.fillText(p.name+' SOI',s.x+r+4,s.y); }
}
function hexToRgba(hex,a){
  const c=hex.replace('#','');
  const num=parseInt(c,16);
  const r=(num>>16)&0xff,g=(num>>8)&0xff,b=num&0xff;
  return `rgba(${r},${g},${b},${a})`;
}
// Procedural cloud blobs for solid bodies with atmosphere
const cloudCache={};
function getClouds(p){
  if(cloudCache[p.key]) return cloudCache[p.key];
  const n=p.solid?18:0;
  const clouds=[];
  let seed=0; for(let i=0;i<p.key.length;i++) seed=(seed*31+p.key.charCodeAt(i))|0;
  const rnd=()=>{ seed=(seed*1103515245+12345)&0x7fffffff; return seed/0x7fffffff; };
  for(let i=0;i<n;i++){
    clouds.push({
      ang:rnd()*Math.PI*2,
      lat:(rnd()-0.5)*1.2,
      w:0.08+rnd()*0.22,
      h:0.03+rnd()*0.08,
      a:0.2+rnd()*0.35,
      spin:(0.15+rnd()*0.4)*(rnd()<0.5?-1:1)
    });
  }
  cloudCache[p.key]=clouds; return clouds;
}
function drawClouds(p,t){
  if(!p.atmo||!p.solid) return;
  const pos=planetPositionAt(p,t);
  const s=worldToScreen(pos.x,pos.y);
  const r=Math.max(1.2,p.radius/camera.metersPerPixel);
  if(r<14) return;
  const CW=flightCanvas.clientWidth, CH=flightCanvas.clientHeight;
  if(s.x<-r*2||s.x>CW+r*2||s.y<-r*2||s.y>CH+r*2) return;
  const clouds=getClouds(p);
  const bodyAng=Math.atan2(pos.y,pos.x);
  fctx.save();
  fctx.beginPath(); fctx.arc(s.x,s.y,r*1.02,0,Math.PI*2); fctx.clip();
  clouds.forEach(c=>{
    const ang=c.ang+t*0.000015*c.spin;
    const rr=r*(0.78+c.h*2);
    const cx=s.x+Math.cos(ang+bodyAng)*rr*Math.cos(c.lat);
    const cy=s.y+Math.sin(ang+bodyAng)*rr;
    const cw=r*c.w, ch=r*c.h;
    const fade=r>40?1:r/40;
    fctx.fillStyle=hexToRgba('#e8f0ff', c.a*fade);
    fctx.beginPath(); fctx.ellipse(cx,cy,cw,ch, ang*0.5, 0, Math.PI*2); fctx.fill();
    fctx.fillStyle=hexToRgba('#ffffff', c.a*0.45*fade);
    fctx.beginPath(); fctx.ellipse(cx+cw*0.25,cy-ch*0.2,cw*0.55,ch*0.7, ang*0.3, 0, Math.PI*2); fctx.fill();
  });
  fctx.restore();
}
function drawPlanet(p,t,viewerPos){
  const pos=planetPositionAt(p,t);
  const s=worldToScreen(pos.x,pos.y);
  const r=Math.max(1.2,p.radius/camera.metersPerPixel);
  const CW=flightCanvas.clientWidth, CH=flightCanvas.clientHeight;
  if(s.x<-r-5||s.x>CW+r+5||s.y<-r-5||s.y>CH+r+5) return;

  if(p.atmo){
    const atmoR=p.solid?r*(1+(p.atmoFrac||0)):r*1.08;
    const glow=fctx.createRadialGradient(s.x,s.y,r*0.85,s.x,s.y,atmoR);
    const ac=p.atmoColor||'#a0c8ff';
    glow.addColorStop(0,hexToRgba(ac,0.22));
    glow.addColorStop(1,hexToRgba(ac,0));
    fctx.beginPath(); fctx.arc(s.x,s.y,atmoR,0,Math.PI*2); fctx.fillStyle=glow; fctx.fill();
  }
  // Solid color body (no surface textures)
  fctx.beginPath(); fctx.arc(s.x,s.y,r,0,Math.PI*2);
  fctx.fillStyle=p.color; fctx.fill();
  // Soft limb shade only
  const shade=fctx.createRadialGradient(s.x-r*0.3,s.y-r*0.3,r*0.05,s.x,s.y,r);
  shade.addColorStop(0,'rgba(255,255,255,0.18)');
  shade.addColorStop(0.55,'rgba(0,0,0,0)');
  shade.addColorStop(1,'rgba(0,0,0,0.35)');
  fctx.beginPath(); fctx.arc(s.x,s.y,r,0,Math.PI*2); fctx.fillStyle=shade; fctx.fill();
  fctx.beginPath(); fctx.arc(s.x,s.y,r,0,Math.PI*2);
  fctx.lineWidth=1; fctx.strokeStyle='rgba(255,255,255,0.14)'; fctx.stroke();
  if(r>10){ fctx.fillStyle='rgba(255,255,255,0.75)'; fctx.font='11px sans-serif'; fctx.fillText(p.name,s.x+r+4,s.y+4); }
}

// Draw a concrete trapezoid launch pad on Earth's surface (outward-from-Sun side)
function drawLaunchPad(){
  const earthPos=planetPositionAt(EARTH,simTime);
  const earthDist=Math.hypot(earthPos.x,earthPos.y)||EARTH.distance;
  const nx=earthPos.x/earthDist; // outward unit vector (Sun → Earth)
  const ny=earthPos.y/earthDist;
  const tx=-ny, ty=nx;          // tangential unit vector

  const PAD_H=LAUNCH_PAD_HEIGHT; // protrudes above surface
  const PAD_EMBED=4;// embedded below surface
  const PAD_B=42;   // base width (world units)
  const PAD_T=28;   // top width (world units)

  // Surface centre of the pad
  const cx=earthPos.x+nx*EARTH.radius;
  const cy=earthPos.y+ny*EARTH.radius;

  // Cull if off-screen or too tiny
  const ps=worldToScreen(cx,cy);
  const CW=flightCanvas.clientWidth,CH=flightCanvas.clientHeight;
  const rPix=Math.max(PAD_B,PAD_H+PAD_EMBED)/camera.metersPerPixel;
  if(rPix<0.4) return;
  if(ps.x<-rPix*4||ps.x>CW+rPix*4||ps.y<-rPix*4||ps.y>CH+rPix*4) return;

  // corners: top face above surface, base below (trapezoid silhouette)
  const TL=worldToScreen(cx+nx*PAD_H+tx*(-PAD_T/2), cy+ny*PAD_H+ty*(-PAD_T/2));
  const TR=worldToScreen(cx+nx*PAD_H+tx*(PAD_T/2),  cy+ny*PAD_H+ty*(PAD_T/2));
  // Base (PAD_EMBED below surface, wider — gives the classic trapezoid silhouette)
  const BL=worldToScreen(cx-nx*PAD_EMBED+tx*(-PAD_B/2), cy-ny*PAD_EMBED+ty*(-PAD_B/2));
  const BR=worldToScreen(cx-nx*PAD_EMBED+tx*(PAD_B/2),  cy-ny*PAD_EMBED+ty*(PAD_B/2));

  // Main body
  fctx.beginPath();
  fctx.moveTo(BL.x,BL.y); fctx.lineTo(BR.x,BR.y);
  fctx.lineTo(TR.x,TR.y); fctx.lineTo(TL.x,TL.y);
  fctx.closePath();
  const grad=fctx.createLinearGradient(TL.x,TL.y,BL.x,BL.y);
  grad.addColorStop(0,'#a8b0b8');
  grad.addColorStop(0.3,'#808890');
  grad.addColorStop(1,'#484e56');
  fctx.fillStyle=grad; fctx.fill();
  fctx.strokeStyle='rgba(255,255,255,0.18)'; fctx.lineWidth=1; fctx.stroke();

  // Top surface stripe markings (yellow dashes) — only when visible at close zoom
  if(rPix>4){
    fctx.save();
    fctx.strokeStyle='#ffcc00';
    fctx.lineWidth=Math.max(1,rPix*0.07);
    fctx.setLineDash([rPix*0.22,rPix*0.12]);
    fctx.beginPath(); fctx.moveTo(TL.x,TL.y); fctx.lineTo(TR.x,TR.y); fctx.stroke();
    fctx.setLineDash([]);
    fctx.restore();
  }
}

