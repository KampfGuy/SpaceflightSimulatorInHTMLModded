// world screen coordinate conversion worldtoscreen rotates
function worldToScreen(wx,wy){
  const cw=flightCanvas.clientWidth, ch=flightCanvas.clientHeight;
  const dx=(wx-camera.x)/camera.metersPerPixel;
  const dy=-(wy-camera.y)/camera.metersPerPixel;
  const a=camera.angle;
  const cos=Math.cos(a), sin=Math.sin(a);
  // Rotate world displacement by +camera.angle so the ship's heading = screen-up
  return {
    x: cw/2 + dx*cos - dy*sin,
    y: ch/2 + dx*sin + dy*cos,
  };
}
function screenToWorld(sx,sy){
  const cw=flightCanvas.clientWidth, ch=flightCanvas.clientHeight;
  const mpp=camera.metersPerPixel;
  const a=camera.angle;
  const cos=Math.cos(a), sin=Math.sin(a);
  const sdx=sx-cw/2, sdy=sy-ch/2;
  // exact inverse worldtoscreen derived from y
  return {
    x: camera.x + mpp*(sdx*cos + sdy*sin),
    y: camera.y + mpp*(sdx*sin - sdy*cos),
  };
}

