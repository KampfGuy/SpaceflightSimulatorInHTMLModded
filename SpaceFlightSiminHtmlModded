function roundRectPath(ctx,x,y,w,h,r){
  r=Math.max(0,Math.min(r,w/2,h/2));
  ctx.beginPath();
  ctx.moveTo(x+r,y); ctx.lineTo(x+w-r,y); ctx.arcTo(x+w,y,x+w,y+r,r);
  ctx.lineTo(x+w,y+h-r); ctx.arcTo(x+w,y+h,x+w-r,y+h,r);
  ctx.lineTo(x+r,y+h); ctx.arcTo(x,y+h,x,y+h-r,r);
  ctx.lineTo(x,y+r); ctx.arcTo(x,y,x+r,y,r);
  ctx.closePath();
}
function shadeColor(hex,amt){
  const c=hex.replace('#','');
  const num=parseInt(c,16);
  let r=(num>>16)+Math.round(255*amt),g=((num>>8)&0xff)+Math.round(255*amt),b=(num&0xff)+Math.round(255*amt);
  r=Math.max(0,Math.min(255,r));g=Math.max(0,Math.min(255,g));b=Math.max(0,Math.min(255,b));
  return 'rgb('+r+','+g+','+b+')';
}
function drawPartShape(ctx,d,x,y,w,h){
  ctx.save();
  // Base path
  if(d.type==='pod'){
    // 1×2 capsule
    roundRectPath(ctx,x,y,w,h,Math.min(w,h)*0.22);
  } else if(d.type==='engine'||d.type==='srb'){
    ctx.beginPath();
    ctx.moveTo(x+w*0.12,y); ctx.lineTo(x+w*0.88,y);
    ctx.lineTo(x+w,y+h); ctx.lineTo(x,y+h); ctx.closePath();
  } else if(d.type==='chute'){
    // small dome canopy for 1×1
    ctx.beginPath();
    ctx.moveTo(x,y+h); ctx.lineTo(x,y+h*0.4);
    ctx.quadraticCurveTo(x,y,x+w/2,y); ctx.quadraticCurveTo(x+w,y,x+w,y+h*0.4);
    ctx.lineTo(x+w,y+h); ctx.closePath();
  } else if(d.type==='separator' || d.type==='sidesep'){
    roundRectPath(ctx,x,y,w,h,Math.min(w,h)*0.12);
  } else if(d.type==='heatshield'){
    // hitbox is 1×1 but texture is only the top half (0.5 tall)
    const hy=y, hh=h*0.5;
    ctx.beginPath();
    ctx.moveTo(x,hy);
    ctx.lineTo(x+w,hy);
    ctx.lineTo(x+w*0.94,hy+hh*0.9);
    ctx.lineTo(x+w*0.06,hy+hh*0.9);
    ctx.closePath();
  } else if(d.type==='tank'&&d.adapter){
    // Trapezoid adapter: botW at bottom, topW at top (defaults: full w at bottom, d.topW cells scaled)
    const topFrac=(d.topW||d.w)/d.w;
    const botFrac=(d.botW||d.w)/d.w;
    const topW=w*topFrac, botW=w*botFrac;
    const topX=x+(w-topW)/2, botX=x+(w-botW)/2;
    ctx.beginPath();
    ctx.moveTo(topX,y); ctx.lineTo(topX+topW,y);
    ctx.lineTo(botX+botW,y+h); ctx.lineTo(botX,y+h);
    ctx.closePath();
  } else if(d.type==='cone'){
    ctx.beginPath();
    ctx.moveTo(x+w/2,y); ctx.lineTo(x+w,y+h); ctx.lineTo(x,y+h); ctx.closePath();
  } else if(d.type==='wheel'||d.type==='legs'){
    roundRectPath(ctx,x,y,w,h,Math.min(w,h)*0.5);
  } else if(d.type==='rcs'){
    // tall thin RCS block
    roundRectPath(ctx,x+w*0.1,y,w*0.8,h,Math.min(w,h)*0.12);
  } else if(d.type==='probe'){
    roundRectPath(ctx,x,y,w,h,Math.min(w,h)*0.15);
  } else if(d.type==='drill'){
    ctx.beginPath();
    ctx.moveTo(x+w*0.2,y); ctx.lineTo(x+w*0.8,y);
    ctx.lineTo(x+w*0.65,y+h*0.55); ctx.lineTo(x+w*0.55,y+h);
    ctx.lineTo(x+w*0.45,y+h); ctx.lineTo(x+w*0.35,y+h*0.55);
    ctx.closePath();
  } else if(d.type==='solar'){
    roundRectPath(ctx,x,y,w,h,Math.min(w,h)*0.08);
  } else if(d.type==='battery'){
    roundRectPath(ctx,x,y,w,h,Math.min(w,h)*0.12);
  } else if(d.type==='antenna'){
    ctx.beginPath();
    ctx.moveTo(x+w*0.45,y+h); ctx.lineTo(x+w*0.55,y+h);
    ctx.lineTo(x+w*0.55,y+h*0.45); ctx.lineTo(x+w*0.45,y+h*0.45);
    ctx.closePath();
  } else if(d.type==='science'){
    roundRectPath(ctx,x,y,w,h,Math.min(w,h)*0.1);
  } else if(d.type==='strut'){
    roundRectPath(ctx,x+w*0.25,y,w*0.5,h,2);
  } else if(d.type==='fairing'){
    if(d.fairingTip){
      ctx.beginPath();
      ctx.moveTo(x+w/2,y); ctx.lineTo(x+w*0.92,y+h); ctx.lineTo(x+w*0.08,y+h); ctx.closePath();
    } else {
      roundRectPath(ctx,x,y,w,h,Math.min(w,h)*0.08);
    }
  } else if(d.type==='solidfuel'){
    roundRectPath(ctx,x,y,w,h,Math.min(w,h)*0.1);
  } else {
    roundRectPath(ctx,x,y,w,h,Math.min(w,h)*0.12);
  }

  // Richer metallic / material gradient fill
  if(d.type==='engine'){
    const engGrad=ctx.createLinearGradient(x,y,x+w,y);
    engGrad.addColorStop(0,shadeColor(d.color,-0.28));
    engGrad.addColorStop(0.25,shadeColor(d.color,0.08));
    engGrad.addColorStop(0.5,shadeColor(d.color,0.22));
    engGrad.addColorStop(0.75,shadeColor(d.color,0.05));
    engGrad.addColorStop(1,shadeColor(d.color,-0.32));
    ctx.fillStyle=engGrad; ctx.fill();
  } else if(d.type==='separator' || d.type==='sidesep'){
    const sepGrad=ctx.createLinearGradient(x,y,x,y+h);
    sepGrad.addColorStop(0,shadeColor(d.color,0.18));
    sepGrad.addColorStop(0.45,d.color);
    sepGrad.addColorStop(0.55,d.color);
    sepGrad.addColorStop(1,shadeColor(d.color,-0.25));
    ctx.fillStyle=sepGrad; ctx.fill();
  } else if(d.type==='heatshield'){
    const hsGrad=ctx.createLinearGradient(x,y,x,y+h);
    hsGrad.addColorStop(0,shadeColor(d.color,0.25));
    hsGrad.addColorStop(0.35,d.color);
    hsGrad.addColorStop(1,shadeColor(d.color,-0.35));
    ctx.fillStyle=hsGrad; ctx.fill();
  } else {
    const grad=ctx.createLinearGradient(x,y,x+w,y);
    grad.addColorStop(0,shadeColor(d.color,-0.22));
    grad.addColorStop(0.18,shadeColor(d.color,0.05));
    grad.addColorStop(0.42,shadeColor(d.color,0.18));
    grad.addColorStop(0.58,shadeColor(d.color,0.18));
    grad.addColorStop(0.82,shadeColor(d.color,0.02));
    grad.addColorStop(1,shadeColor(d.color,-0.26));
    ctx.fillStyle=grad; ctx.fill();
  }

  // Soft outer rim
  ctx.lineWidth=Math.max(1.1,w*0.025);
  ctx.strokeStyle='rgba(0,0,0,0.55)'; ctx.stroke();

  // Vanilla / simple textures — skip detailed surface work when mod textures are off
  if(!modSettings.realisticTextures){
    // minimal classic marks so parts stay readable
    if(d.type==='tank'){
      ctx.strokeStyle='rgba(0,0,0,0.22)'; ctx.lineWidth=Math.max(1,h*0.014);
      [0.16,0.84].forEach(t=>{ ctx.beginPath(); ctx.moveTo(x+w*0.08,y+h*t); ctx.lineTo(x+w*0.92,y+h*t); ctx.stroke(); });
    }
    if(d.type==='engine'){
      ctx.fillStyle='rgba(20,10,5,0.65)';
      ctx.beginPath(); ctx.ellipse(x+w/2,y+h*0.94,w*0.32,h*0.09,0,0,Math.PI*2); ctx.fill();
    }
    if(d.type==='pod'){
      ctx.fillStyle='rgba(255,255,255,0.5)';
      ctx.beginPath(); ctx.ellipse(x+w*0.5,y+h*0.35,w*0.18,h*0.14,0,0,Math.PI*2); ctx.fill();
    }
    if(d.type==='separator'){
      ctx.strokeStyle='rgba(255,255,255,0.5)'; ctx.setLineDash([w*0.08,w*0.06]);
      ctx.lineWidth=Math.max(1,h*0.35);
      ctx.beginPath(); ctx.moveTo(x+w*0.05,y+h/2); ctx.lineTo(x+w*0.95,y+h/2); ctx.stroke();
      ctx.setLineDash([]);
    }
    if(d.type==='dock'){
      ctx.strokeStyle='rgba(255,255,255,0.6)'; ctx.lineWidth=Math.max(1,h*0.12);
      ctx.strokeRect(x+w*0.2,y+h*0.15,w*0.6,h*0.7);
    }
    ctx.restore();
    return;
  }

  // ---- Type-specific surface detail / texture (realistic mod) ----
  if(d.type==='tank'){
    // Horizontal panel lines + rivets
    ctx.strokeStyle='rgba(0,0,0,0.28)';
    ctx.lineWidth=Math.max(1,h*0.012);
    const bands=[0.12,0.28,0.5,0.72,0.88];
    bands.forEach(t=>{
      ctx.beginPath(); ctx.moveTo(x+w*0.07,y+h*t); ctx.lineTo(x+w*0.93,y+h*t); ctx.stroke();
    });
    // subtle vertical seam
    ctx.strokeStyle='rgba(0,0,0,0.18)';
    ctx.beginPath(); ctx.moveTo(x+w*0.5,y+h*0.06); ctx.lineTo(x+w*0.5,y+h*0.94); ctx.stroke();
    // rivets
    ctx.fillStyle='rgba(30,30,35,0.55)';
    for(let i=0;i<5;i++){
      const ry=y+h*(0.12+i*0.19);
      ctx.beginPath(); ctx.arc(x+w*0.14,ry,Math.max(1,w*0.035),0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(x+w*0.86,ry,Math.max(1,w*0.035),0,Math.PI*2); ctx.fill();
    }
    // top highlight strip
    ctx.fillStyle='rgba(255,255,255,0.12)';
    ctx.fillRect(x+w*0.08,y+h*0.04,w*0.84,h*0.06);
  }

  if(d.type==='engine'||d.type==='srb'){
    // nozzle interior
    ctx.fillStyle='rgba(18,8,4,0.75)';
    ctx.beginPath();
    ctx.ellipse(x+w/2,y+h*0.93,w*0.34,h*0.1,0,0,Math.PI*2);
    ctx.fill();
    if(d.type==='srb'){
      // solid booster white/orange stripes
      ctx.fillStyle='rgba(255,255,255,0.22)';
      for(let i=0;i<4;i++) ctx.fillRect(x+w*0.12,y+h*(0.12+i*0.18),w*0.76,h*0.08);
      ctx.fillStyle='rgba(255,100,20,0.35)';
      ctx.fillRect(x+w*0.12,y+h*0.45,w*0.76,h*0.1);
      ctx.strokeStyle='rgba(0,0,0,0.4)'; ctx.lineWidth=Math.max(1,w*0.04);
      ctx.strokeRect(x+w*0.1,y+h*0.06,w*0.8,h*0.88);
    } else {
      // cooling fins / ridges
      ctx.strokeStyle='rgba(0,0,0,0.35)';
      ctx.lineWidth=Math.max(1,h*0.04);
      for(let i=1;i<=4;i++){
        const ty=y+h*(0.18+i*0.14);
        ctx.beginPath(); ctx.moveTo(x+w*0.15,ty); ctx.lineTo(x+w*0.85,ty); ctx.stroke();
      }
      ctx.fillStyle='rgba(255,220,180,0.18)';
      ctx.fillRect(x+w*0.14,y+h*0.02,w*0.72,h*0.1);
      ctx.strokeStyle='rgba(255,140,60,0.35)';
      ctx.lineWidth=Math.max(1,w*0.03);
      ctx.beginPath();
      ctx.moveTo(x+w*0.18,y+h*0.08); ctx.lineTo(x+w*0.82,y+h*0.08); ctx.stroke();
    }
  }

  if(d.type==='pod'){
    if(d.planeCockpit){
      // aircraft canopy / cockpit
      ctx.fillStyle='rgba(20,30,40,0.9)';
      ctx.fillRect(x+w*0.08,y+h*0.45,w*0.84,h*0.5);
      // bubble canopy glass
      const cg=ctx.createLinearGradient(x,y,x+w,y+h*0.5);
      cg.addColorStop(0,'rgba(120,190,255,0.55)');
      cg.addColorStop(0.4,'rgba(40,80,140,0.7)');
      cg.addColorStop(1,'rgba(20,40,80,0.85)');
      ctx.fillStyle=cg;
