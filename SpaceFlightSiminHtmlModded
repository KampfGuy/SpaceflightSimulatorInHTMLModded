// Moons are calculated based on the home planet multiplicatively. I dont know why I did it this specific way. Claude could've doneit better probably. Its all not standard but makes sense to me. Sorry modders.
let moonAngleSeed=0;
const MOON_DEFS = [
  {key:'moon',    name:'The Moon',parent:'earth',  color:'#bdbdbd',groundColor:'#9a9a9a',radiusMod:0.27240,distMod:30.15, surfG:1.62,  eccMod:0.94510,solid:true,atmo:false}, //moon dist unrealistic. I know. i halved it for gameplay reasons

