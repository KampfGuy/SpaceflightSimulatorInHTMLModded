  {key:'tethys',   name:'Tethys',   parent:'saturn',color:'#d6d6ce',groundColor:'#b8b8b0',radiusMod:0.00881,distMod:5.06, surfG:0.145, eccMod:0.99990,solid:true,atmo:false},
  {key:'dione',    name:'Dione',    parent:'saturn',color:'#c9c9c1',groundColor:'#aaaaa2',radiusMod:0.00932,distMod:6.48, surfG:0.232, eccMod:0.99780,solid:true,atmo:false},
  {key:'rhea',     name:'Rhea',     parent:'saturn',color:'#d0d0c8',groundColor:'#b0b0a8',radiusMod:0.01267,distMod:9.05, surfG:0.264, eccMod:0.99900,solid:true,atmo:false},
  {key:'titan',    name:'Titan',    parent:'saturn',color:'#e0b060',groundColor:'#c09040',radiusMod:0.04272,distMod:20.99,surfG:1.35,  eccMod:0.97120,solid:true,atmo:false},
