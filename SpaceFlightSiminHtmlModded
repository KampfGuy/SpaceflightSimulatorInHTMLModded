// ---- Animals (visual only) ----
const animalSeed=42;
function drawAnimals(){
  return; // animals removed
  if(!modSettings.animals) return;
  ALL_BODIES.forEach(p=>{
    if(p.key!=='earth'&&p.key!=='europa') return;
    const ppos=planetPositionAt(p,simTime);
    const rPix=p.radius/camera.metersPerPixel;
    if(rPix<60) return; // only when zoomed in enough to see creatures
    for(let i=0;i<10;i++){
      const ang=((i*37+animalSeed*3)%360)*Math.PI/180;
      const rr=p.radius*(p.key==='europa'?0.990:1.003);
      const wx=ppos.x+Math.cos(ang)*rr, wy=ppos.y+Math.sin(ang)*rr;
      const ps=worldToScreen(wx,wy);
      if(ps.x<-30||ps.y<-30||ps.x>flightCanvas.clientWidth+30) continue;
      const sc=Math.max(2, Math.min(8, rPix/80));
      fctx.save();
      fctx.translate(ps.x,ps.y);
      if(p.key==='earth'){
        // simple four-leg critter
        fctx.fillStyle='#5a3a1a';
        fctx.fillRect(-sc*0.8,-sc*0.3,sc*1.6,sc*0.7); // body
        fctx.fillStyle='#6b4420';
        fctx.beginPath(); fctx.arc(sc*0.7,-sc*0.35,sc*0.45,0,Math.PI*2); fctx.fill(); // head
        fctx.fillStyle='#3a2810';
        fctx.fillRect(-sc*0.6,sc*0.3,sc*0.25,sc*0.5);
        fctx.fillRect(sc*0.2,sc*0.3,sc*0.25,sc*0.5);
        // eye
        fctx.fillStyle='#fff'; fctx.fillRect(sc*0.85,-sc*0.45,sc*0.15,sc*0.15);
      } else {
        // Europa sea creature
        fctx.fillStyle='#4ac0e0';
        fctx.beginPath(); fctx.ellipse(0,0,sc*1.2,sc*0.55,0,0,Math.PI*2); fctx.fill();
        fctx.strokeStyle='#2a80a0'; fctx.lineWidth=1;
        fctx.beginPath(); fctx.moveTo(-sc*1.2,0); fctx.lineTo(-sc*1.8,sc*0.4); fctx.stroke();
        fctx.beginPath(); fctx.moveTo(-sc*1.2,0); fctx.lineTo(-sc*1.8,-sc*0.4); fctx.stroke();
        fctx.fillStyle='#fff'; fctx.beginPath(); fctx.arc(sc*0.5,-sc*0.1,sc*0.18,0,Math.PI*2); fctx.fill();
        fctx.fillStyle='#000'; fctx.beginPath(); fctx.arc(sc*0.55,-sc*0.1,sc*0.08,0,Math.PI*2); fctx.fill();
      }
      fctx.restore();
    }
  });
}

// ---- Draw flags & astronauts ----
function drawFlagsAndCrew(){
