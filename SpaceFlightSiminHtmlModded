// ---------- Grid camera ----------
function gridOrigin(CW,CH){
  const cellPx=BASE_CELL*gridCam.zoom;
  return {cellPx, ox:CW/2-gridCam.x*cellPx, oy:CH/2-gridCam.y*cellPx};
}
function clampGridCam(){
  const m=14;
  gridCam.x=Math.max(-m,Math.min(COLS+m,gridCam.x));
  gridCam.y=Math.max(-m,Math.min(ROWS+m,gridCam.y));
  gridCam.zoom=Math.max(GRID_MIN_ZOOM,Math.min(GRID_MAX_ZOOM,gridCam.zoom));
}
function cellFromEvent(e){
  const rect=gridCanvas.getBoundingClientRect();
  const mx=e.clientX-rect.left, my=e.clientY-rect.top;
  const {cellPx,ox,oy}=gridOrigin(rect.width,rect.height);
  return {col:Math.floor((mx-ox)/cellPx), row:Math.floor((my-oy)/cellPx)};
}
function rectsOverlap(a,b){
  return a.col<b.col+b.w && a.col+a.w>b.col && a.row<b.row+b.h && a.row+a.h>b.row;
}
// Rotation (0/90/180/270 clockwise) swaps footprint w<->h at odd multiples of 90 — 2x1 rotated 90 becomes 1x2
function effDims(partDefId,rot){
  const d=PARTS[partDefId];
  return ((rot||0)%180===0) ? {w:d.w,h:d.h} : {w:d.h,h:d.w};
}
function partRot(pp){ return pp.rot||0; }
function partFootprint(partDefId,col,row,rot){
  const eff=effDims(partDefId,rot);
  return {col,row,w:eff.w,h:eff.h};
}
function placedFootprint(pp){
  const fp=partFootprint(pp.id,pp.col,pp.row,partRot(pp));
  // Separators / fairings autosize width
  if(PARTS[pp.id]&&(PARTS[pp.id].type==='separator'||PARTS[pp.id].type==='fairing')&&pp.autoW&&pp.autoW>0){
    fp.w=pp.autoW;
    if(typeof pp.autoCol==='number') fp.col=pp.autoCol;
  }
  if(PARTS[pp.id]&&PARTS[pp.id].type==='fairing'&&pp.autoH&&pp.autoH>0) fp.h=pp.autoH;
  return fp;
}
// Match separator / fairing width to part below; fairings also stretch height to cover payload stack
function recomputeSeparatorAutosize(list){
  const parts=list||placedParts;
  parts.forEach(pp=>{
    const d=PARTS[pp.id];
    if(!d||(d.type!=='separator'&&d.type!=='fairing')){
      delete pp.autoW; delete pp.autoCol; delete pp.autoH; return;
    }
    if(d.fairingTip){ delete pp.autoW; delete pp.autoCol; delete pp.autoH; return; }
    const base=partFootprint(pp.id,pp.col,pp.row,partRot(pp));
    let best=null;
    parts.forEach(o=>{
      if(o.uid===pp.uid) return;
      const od=PARTS[o.id];
      if(od&&(od.type==='separator'||od.type==='fairing')) return;
      const ofp=partFootprint(o.id,o.col,o.row,partRot(o));
      if(ofp.row===base.row+base.h && ofp.col<base.col+base.w && ofp.col+ofp.w>base.col){
        if(!best||ofp.w>best.w) best=ofp;
      }
    });
    if(best){
      pp.autoW=best.w;
      pp.autoCol=best.col;
    } else {
      delete pp.autoW; delete pp.autoCol;
    }
    // Fairings: grow height upward to cover stacked payload until tip/empty
    if(d.type==='fairing'){
      let coverH=base.h;
      let top=base.row;
      // look for parts above within column span and extend
      parts.forEach(o=>{
        if(o.uid===pp.uid) return;
        const ofp=partFootprint(o.id,o.col,o.row,partRot(o));
        const colOverlap=ofp.col<base.col+(pp.autoW||base.w) && ofp.col+ofp.w>base.col;
        if(colOverlap&&ofp.row+ofp.h<=base.row){
          // part above
          const extent=base.row+base.h - ofp.row;
          if(extent>coverH) coverH=extent;
        }
      });
      if(coverH>base.h) pp.autoH=coverH; else delete pp.autoH;
    }
  });
}
// True if any part in `parts` overlaps the 1-row horizontal band [row,row+1) across [col,col+w)
function bandOccupied(parts,col,w,row){
  return parts.some(pp=>{
    const fp=placedFootprint(pp);
    return col<fp.col+fp.w && col+w>fp.col && row<fp.row+fp.h && row+1>fp.row;
  });
}
// True if any part in `parts` overlaps the 1-column vertical band [col,col+1) across [row,row+h)
function bandOccupiedCol(parts,row,h,col){
  return parts.some(pp=>{
    const fp=placedFootprint(pp);
    return row<fp.row+fp.h && row+h>fp.row && col<fp.col+fp.w && col+1>fp.col;
  });
}
// Dir codes = rotation degrees (0=up,90=right,180=down,270=left); true if hull touches that side
function dirHullAdjacent(parts,col,row,w,h,dir){
  switch(((dir%360)+360)%360){
    case 0:   return bandOccupied(parts,col,w,row-1);     // hull above
    case 180: return bandOccupied(parts,col,w,row+h);     // hull below
    case 90:  return bandOccupiedCol(parts,row,h,col+w);  // hull to the right
    case 270: return bandOccupiedCol(parts,row,h,col-1);  // hull to the left
    default:  return false;
  }
}
function canPlace(partDefId,col,row,rot){
  rot=rot||0;
  const d=PARTS[partDefId];
  const eff=effDims(partDefId,rot);
  if(col<0||row<0||col+eff.w>COLS||row+eff.h>ROWS) return false;
  if(d.type==='dock'){
    // must sit against hull on the mounted side; open side stays clear to dock with
    const openDir=rot, mountDir=(rot+180)%360;
    const mounted=dirHullAdjacent(placedParts,col,row,eff.w,eff.h,mountDir);
    const openBlocked=dirHullAdjacent(placedParts,col,row,eff.w,eff.h,openDir);
    if(!mounted||openBlocked) return false;
  }
  if(cheats.buildNoclip) return true;
  const fp=partFootprint(partDefId,col,row,rot);
  for(const pp of placedParts){
    if(rectsOverlap(fp,placedFootprint(pp))) return false;
  }
  return true;
}

