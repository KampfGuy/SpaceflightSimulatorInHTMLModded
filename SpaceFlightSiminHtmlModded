// Teleport cheat — drop active ship just above a planet surface
(function fillTeleportSelect(){
  const sel=el('cheatTeleport'); if(!sel) return;
  PLANETS.forEach(p=>{
    const o=document.createElement('option');
    o.value=p.key; o.textContent=p.name;
    sel.appendChild(o);
  });
  sel.onchange=()=>{
    const key=sel.value; if(!key) return;
    const body=BODIES_BY_KEY[key]; if(!body) return;
    const sh=activeShip(); if(!sh){ showToast('No active ship'); sel.value=''; return; }
    const ppos=planetPositionAt(body,simTime);
    const pvel=planetVelocityAt(body,simTime);
    // Surface-normal from planet center (works for any SOI, not just sun-facing)
    const foot=sh.sprite?sh.sprite.comYc*CELL_WORLD:8;
    if(body.solid){
      // Land flush on surface
      const ang=Math.atan2(1,0); // default "up" in world — use outward from sun for pad feel
      const dist=Math.hypot(ppos.x,ppos.y)||1;
      const nx=ppos.x/dist, ny=ppos.y/dist;
      const surfR=body.radius+foot+2;
      sh.pos.x=ppos.x+nx*surfR; sh.pos.y=ppos.y+ny*surfR;
      sh.vel.x=pvel.x; sh.vel.y=pvel.y;
      sh.angle=Math.atan2(nx,ny);
      sh.status='landed'; sh.statusMsg='Landed on '+body.name;
      sh.landedOnPlanet=body;
      sh.landedRelPos={x:sh.pos.x-ppos.x,y:sh.pos.y-ppos.y};
      sh._inAtmo=!!body.atmo;
    } else {
      // Gas giant — float high in the outer atmosphere, not deep
      const dist=Math.hypot(ppos.x,ppos.y)||1;
      const nx=ppos.x/dist, ny=ppos.y/dist;
      const floatR=body.radius*0.92;
      sh.pos.x=ppos.x+nx*floatR; sh.pos.y=ppos.y+ny*floatR;
      sh.vel.x=pvel.x; sh.vel.y=pvel.y;
      sh.angle=Math.atan2(nx,ny);
      sh.status='flying'; sh.statusMsg='';
      sh.landedOnPlanet=null; sh.landedRelPos=null;
      sh._inAtmo=true;
    }
    sh._domBody=body;
    sh.heatAcc=0; sh._suborbitalDoom=false; sh.engineOn=false;
    camera.x=sh.pos.x; camera.y=sh.pos.y;
    if(typeof setCamFree==='function') setCamFree(false);
    camera.metersPerPixel=Math.min(40, body.radius/60);
    sel.value='';
    showToast(body.solid?('Landed on '+body.name):('Teleported to '+body.name+' atmosphere'));
    updateEngineBtn(); updateChuteBtn();
  };
})();

// ---------- TypeEdit: read the current ship/telemetry state into the inputs ----------
function populateTypeEditInputs(){
  const sh=activeShip();
  if(!sh){ ['te-speed','te-alt','te-fuel','te-throttle'].forEach(id=>el(id).value=''); el('te-warp').value=warp; return; }
  let speed,alt;
  if(sh._domBody){
    const ppos=planetPositionAt(sh._domBody,simTime);
    const pv=planetVelocityAt(sh._domBody,simTime);
    speed=Math.hypot(sh.vel.x-pv.x,sh.vel.y-pv.y);
    alt=Math.hypot(sh.pos.x-ppos.x,sh.pos.y-ppos.y)-sh._domBody.radius;
  } else {
    speed=Math.hypot(sh.vel.x,sh.vel.y);
    alt=Math.hypot(sh.pos.x-SUN_POS.x,sh.pos.y-SUN_POS.y)-SUN_RADIUS;
  }
  el('te-speed').value=speed.toFixed(1);
  el('te-alt').value=Math.round(alt);
  el('te-fuel').value=sh.fuelCap?Math.round(100*sh.fuel/sh.fuelCap):0;
  el('te-throttle').value=Math.round(sh.throttle*100);
  el('te-warp').value=warp;
}

// ---------- TypeEdit: apply a typed value back onto the active ship ----------
function teApplySpeed(val){
  const sh=activeShip(); const v=parseFloat(val);
  if(!sh||!isFinite(v)||v<0) return;
  let refVx=0, refVy=0;
  if(sh._domBody){
    const pv=planetVelocityAt(sh._domBody,simTime);
    refVx=pv.x; refVy=pv.y;
  }
  let rvx=sh.vel.x-refVx, rvy=sh.vel.y-refVy;
  let mag=Math.hypot(rvx,rvy);
  if(mag<1e-6){ rvx=Math.sin(sh.angle); rvy=Math.cos(sh.angle); mag=1; } // no direction to scale — use ship heading
  const scale=v/mag;
  sh.vel.x=refVx+rvx*scale; sh.vel.y=refVy+rvy*scale;
}
function teApplyAltitude(val){
  const sh=activeShip(); const v=parseFloat(val);
  if(!sh||!isFinite(v)) return;
  const centerPos=sh._domBody?planetPositionAt(sh._domBody,simTime):SUN_POS;
  const surfaceR=sh._domBody?sh._domBody.radius:SUN_RADIUS;
  let dx=sh.pos.x-centerPos.x, dy=sh.pos.y-centerPos.y;
  const dist=Math.hypot(dx,dy)||1;
  const nx=dx/dist, ny=dy/dist;
  const newDist=surfaceR+Math.max(0,v);
  sh.pos.x=centerPos.x+nx*newDist; sh.pos.y=centerPos.y+ny*newDist;
  if(sh.status==='landed'){
    sh.status='flying'; sh.statusMsg=''; sh.landedOnPlanet=null; sh.landedRelPos=null;
    updateEngineBtn();
  }
}
function teApplyFuel(val){
  const sh=activeShip(); let pct=parseFloat(val);
  if(!sh||!isFinite(pct)) return;
  pct=Math.max(0,Math.min(100,pct))/100;
  sh.parts.forEach(pp=>{ if(PARTS[pp.id].type==='tank') sh.tankFuel[pp.uid]=PARTS[pp.id].fuel*pct; });
  sh.fuel=Object.values(sh.tankFuel).reduce((a,b)=>a+b,0);
  renderFuelList();
}
function teApplyThrottle(val){
  const sh=activeShip(); let pct=parseFloat(val);
  if(!sh||!isFinite(pct)) return;
  pct=Math.max(0,Math.min(100,pct));
  sh.throttle=pct/100;
  el('throttleSlider').value=Math.round(pct);
  hud.throttle.textContent=Math.round(pct)+'%';
}
function teApplyWarp(val){
  const v=parseFloat(val);
  if(isFinite(v)&&v>0) setWarp(v);
}
el('te-speed').onchange=e=>teApplySpeed(e.target.value);
el('te-alt').onchange=e=>teApplyAltitude(e.target.value);
