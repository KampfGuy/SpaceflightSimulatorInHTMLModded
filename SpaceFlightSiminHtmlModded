function boardAstronaut(sh){
  const a=astronauts.find(x=>x.shipId===sh.id&&x.outside);
  if(!a) return;
  const d=Math.hypot(a.pos.x-sh.pos.x,a.pos.y-sh.pos.y);
  if(d>80){ showToast('Too far from pod to board'); return; }
  a.outside=false; astronauts=astronauts.filter(x=>x!==a);
  showToast('Crew boarded');
}
function updateAstronauts(dt){
  dt=Math.min(Math.max(dt||0.016,0.001),0.05);
  const sh=activeShip();
  astronauts.forEach(a=>{
    if(!a.outside) return;
    // Grabbed onto ship — ride with it
    if(a.grabbed&&sh){
      a.pos.x=sh.pos.x; a.pos.y=sh.pos.y;
      a.vel.x=sh.vel.x; a.vel.y=sh.vel.y;
      a.onSurface=false;
      return;
    }
    const dom=findDominantBody(a.pos,simTime);
    if(!dom||!dom.p.solid){
      // Deep space / gas — free RCS
      let ax=0,ay=0;
      if(keys['w']) ay+=1; if(keys['s']) ay-=1; if(keys['a']) ax-=1; if(keys['d']) ax+=1;
      if(ax||ay){ const m=Math.hypot(ax,ay)||1; a.vel.x+=ax/m*30*dt; a.vel.y+=ay/m*30*dt; }
      if(dom){
        const dx=dom.ppos.x-a.pos.x, dy=dom.ppos.y-a.pos.y;
        const r=Math.hypot(dx,dy)||1;
        const g=dom.p.GM/(r*r);
        a.vel.x+=dx/r*g*dt; a.vel.y+=dy/r*g*dt;
      }
      a.pos.x+=a.vel.x*dt; a.pos.y+=a.vel.y*dt;
      a.onSurface=false;
      return;
    }
    // Solid body — gravity + hard surface collision (no falling through)
    const ppos=planetPositionAt(dom.p,simTime);
    const pvel=planetVelocityAt(dom.p,simTime);
    const EVA_H=1.8; // stand height above surface
    const surfR=dom.p.radius+EVA_H;
    // Relative to planet
    let rx=a.pos.x-ppos.x, ry=a.pos.y-ppos.y;
    let r=Math.hypot(rx,ry)||1;
    let ox=rx/r, oy=ry/r; // outward normal
    // Gravity (toward center)
    const g=dom.p.GM/(r*r);
    a.vel.x-=ox*g*dt; a.vel.y-=oy*g*dt;
    // Surface walk when grounded
    const grounded=r<=surfR+2.5;
    if(grounded){
      a.onSurface=true; a.body=dom.p;
      // Tangential WASD walk (A/D left-right along surface, W/S radial jump/crouch)
      const tx=-oy, ty=ox;
      let walk=0, jump=0;
      if(keys['d']) walk+=1; if(keys['a']) walk-=1;
      if(keys['w']) jump=1;
      // Cancel relative velocity into planet frame for stable standing
      let rvx=a.vel.x-pvel.x, rvy=a.vel.y-pvel.y;
      // Project out radial component while grounded (can't fall in)
      const vRad=rvx*ox+rvy*oy;
      if(vRad<0){ rvx-=vRad*ox; rvy-=vRad*oy; }
      // Apply walk along tangent
      const walkSp=18;
      rvx=tx*walk*walkSp + ox*(jump?12:0);
      rvy=ty*walk*walkSp + oy*(jump?12:0);
      a.vel.x=pvel.x+rvx; a.vel.y=pvel.y+rvy;
    } else {
      a.onSurface=false;
      // Free EVA thrust
      let ax=0,ay=0;
      if(keys['w']) ay+=1; if(keys['s']) ay-=1; if(keys['a']) ax-=1; if(keys['d']) ax+=1;
      if(ax||ay){ const m=Math.hypot(ax,ay)||1; a.vel.x+=ax/m*28*dt; a.vel.y+=ay/m*28*dt; }
    }
    // Integrate
    a.pos.x+=a.vel.x*dt; a.pos.y+=a.vel.y*dt;
    // Hard clamp — never allow center distance < surface radius
    rx=a.pos.x-ppos.x; ry=a.pos.y-ppos.y;
    r=Math.hypot(rx,ry)||1;
    if(r<surfR){
      ox=rx/r; oy=ry/r;
      a.pos.x=ppos.x+ox*surfR;
      a.pos.y=ppos.y+oy*surfR;
      // Kill inward relative velocity
      let rvx=a.vel.x-pvel.x, rvy=a.vel.y-pvel.y;
      const vRad=rvx*ox+rvy*oy;
      if(vRad<0){ rvx-=vRad*ox; rvy-=vRad*oy; }
      a.vel.x=pvel.x+rvx; a.vel.y=pvel.y+rvy;
      a.onSurface=true; a.body=dom.p;
    }
  });
}
