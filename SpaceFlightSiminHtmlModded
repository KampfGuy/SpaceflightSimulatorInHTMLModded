function statsFromParts(parts){
  let dryMass=0,fuel=0,thrust=0,fuelRate=0,pods=0,engines=0,chutes=0,seps=0,probes=0;
  parts.forEach(pp=>{
    const d=PARTS[pp.id]; if(!d) return;
    dryMass+=d.dryMass; fuel+=d.fuel; thrust+=d.thrust; fuelRate+=d.fuelRate;
    if(d.type==='pod') pods++;
    if(d.type==='probe') probes++;
    if(d.type==='engine'||d.type==='srb'||d.type==='prop'||d.type==='shipprop') engines++;
    if(d.type==='chute') chutes++;
    if(d.type==='separator'||d.type==='sidesep') seps++;
  });
  return {dryMass,fuel,wetMass:dryMass+fuel,thrust,fuelRate,pods,engines,chutes,seps,probes,control:pods+probes};
}
// True if two placed-part footprints share a grid edge (touch directly).
function footprintsTouch(a,b){
  const afp=placedFootprint(a), bfp=placedFootprint(b);
  const aL=afp.col, aR=afp.col+afp.w, aT=afp.row, aB=afp.row+afp.h;
  const bL=bfp.col, bR=bfp.col+bfp.w, bT=bfp.row, bB=bfp.row+bfp.h;
  const colOverlap=aL<bR&&aR>bL, rowOverlap=aT<bB&&aB>bT;
  const vertTouch=colOverlap&&(aB===bT||bB===aT);
  const horizTouch=rowOverlap&&(aR===bL||bR===aL);
  return vertTouch||horizTouch;
}
// each engine bfs outward through touching
function computeEngineConnections(parts){
  const engines=parts.filter(pp=>{const t=PARTS[pp.id].type; return t==='engine'||t==='rcs'||t==='srb'||t==='prop'||t==='shipprop';});
  const connections={};
  engines.forEach(eng=>{
    // reference row engine s own center
    const engFp=placedFootprint(eng);
    const engCenterRow=engFp.row+engFp.h/2;
    const visited=new Set([eng.uid]);
    const tankUids=[];
    const queue=[eng];
    while(queue.length){
      const cur=queue.shift();
      parts.forEach(other=>{
        const ot=PARTS[other.id].type;
        if(visited.has(other.uid)||(ot!=='tank'&&ot!=='solidfuel')) return;
        if(!footprintsTouch(cur,other)) return;
        const otherFp=placedFootprint(other);
        const otherCenterRow=otherFp.row+otherFp.h/2;
        if(otherCenterRow>engCenterRow) return;
        visited.add(other.uid);
        tankUids.push(other.uid);
        queue.push(other);
      });
    }
    connections[eng.uid]=tankUids;
  });
  return connections;
}
// LEO Δv budget: circular speed + ~70% gravity/drag losses (game-scale Earth)
const ORBIT_ALT_FRAC = 0.06;
function earthOrbitDvRequired(){
  const r=EARTH.radius*(1+ORBIT_ALT_FRAC);
  const vCirc=Math.sqrt(EARTH.GM/r);
  return vCirc*2.55; // surface→LEO incl. gravity/drag losses (game scale)
}
function circularSpeedAt(body, radius){
  if(!body||radius<=0) return 0;
  return Math.sqrt(body.GM/radius);
}
function computeRocketStats(){
